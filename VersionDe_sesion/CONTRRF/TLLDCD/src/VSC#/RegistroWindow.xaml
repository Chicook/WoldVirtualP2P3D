<Window x:Class="Visor3D.RegistroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D — Crear Cuenta"
        Width="620" Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C12"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanMinimize">

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Título ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Crear Cuenta"
                       Foreground="#00D9FF"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Tu identidad hardware es única y forma parte de tu clave de acceso"
                       Foreground="#576070"
                       FontSize="11"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Panel de información de hardware ── -->
        <Border Grid.Row="2"
                Background="#0F1420"
                BorderBrush="#1D3557"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SO -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Sistema Operativo"
                           Foreground="#8892B0" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtOS"
                           Grid.Row="0" Grid.Column="1"
                           Text="Detectando..."
                           Foreground="#E2E8F0" FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- Placa base -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Placa Base"
                           Foreground="#8892B0" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMotherboard"
                           Grid.Row="2" Grid.Column="1"
                           Text="Detectando..."
                           Foreground="#E2E8F0" FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- CPU -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Procesador"
                           Foreground="#8892B0" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCPU"
                           Grid.Row="4" Grid.Column="1"
                           Text="Detectando..."
                           Foreground="#E2E8F0" FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- Separador -->
                <Separator Grid.Row="5" Grid.ColumnSpan="2"
                           Background="#1D3557" Margin="0,4"/>

                <!-- Hash -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Hash SHA-256"
                           Foreground="#00D9FF" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHash"
                           Grid.Row="6" Grid.Column="1"
                           Text="Generando..."
                           Foreground="#00D9FF" FontSize="10"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ── Nota informativa ── -->
        <Border Grid.Row="4"
                Background="#091220"
                BorderBrush="#163B67"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10"
                VerticalAlignment="Top">
            <TextBlock Foreground="#576070"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       LineHeight="17">
                <Run FontWeight="Bold" Foreground="#8892B0">¿Qué se guarda?</Run>
                <LineBreak/>
                Se genera un hash único a partir de la información de tu hardware (SO, placa base, CPU).
                Este hash actúa como huella de tu dispositivo y no contiene datos personales.
                <LineBreak/><LineBreak/>
                Descarga el archivo <Run FontWeight="Bold" Foreground="#8892B0">.zip</Run> y guárdalo en un lugar seguro.
                Dentro encontrarás un <Run FontWeight="Bold" Foreground="#8892B0">hardware_id.json</Run> con tu hash SHA-256.
            </TextBlock>
        </Border>

        <!-- ── Botón Descargar ── -->
        <Button x:Name="BtnDescargar"
                Grid.Row="6"
                Content="⬇  Descargar identificador de hardware (.zip)"
                Height="40"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Background="#0077B6"
                BorderBrush="#0096C7"
                BorderThickness="1"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- ── Botón Volver / Siguiente paso ── -->
        <Button x:Name="BtnVolver"
                Grid.Row="8"
                Content="← Volver a la pantalla de inicio"
                Height="36"
                FontSize="12"
                Foreground="#576070"
                Background="Transparent"
                BorderBrush="#1D3557"
                BorderThickness="1"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- ── Indicador de descarga completada (al fondo de la ventana) ── -->
        <TextBlock x:Name="TxtDescargaOk"
                   Grid.Row="10"
                   Text="✔ Archivo descargado correctamente — ya puedes continuar con «Siguiente paso →»"
                   Foreground="#22C55E"
                   FontSize="11"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
