<Window x:Class="Visor3D.MigracionCuentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D — Migración al hash único de cuenta"
        Width="700" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        WindowStyle="ThreeDBorderWindow"
        AllowsTransparency="False"
        ResizeMode="NoResize">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="MIGRACIÓN DE CUENTA: HASH ÚNICO"
                       Foreground="#00D9FF" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Sustituye tu llave de acceso, el hash del PC y la frase semilla por un único hash de cuenta generado por la blockchain privada."
                       Foreground="#8892B0" FontSize="12.5" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Tarjeta central -->
        <Border Grid.Row="1"
                Background="#0F1420"
                BorderBrush="#1D3557"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="22">
            <StackPanel VerticalAlignment="Center">
                <Border Background="#162238" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="👤 Usuario: " Foreground="#8892B0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNick" Text="---" Foreground="#00D9FF" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="SE SUSTITUYE:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#0A0D14" BorderBrush="#163B67" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="• llave_acceso.json (La Llave)" Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock Text="• hardware_hash (hash del registro del PC)" Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock Text="• seed_hash (frase semilla de la wallet)" Foreground="#94A3B8" FontSize="12" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="POR UN ÚNICO HASH DE CUENTA:" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#0A0D14" BorderBrush="#163B67" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtHashCuenta"
                               Text="(aún no generado)"
                               Foreground="#38BDF8" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                </Border>

                <TextBlock x:Name="TxtEstado"
                           Text="Pulsa «Migrar» para solicitar tu bloque de cuenta a la blockchain local."
                           Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnMigrar"
                            Content="⛓ Migrar a hash único"
                            Height="40" MinWidth="180"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Background="#0077B6"
                            BorderBrush="#0096C7"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnDescargarZip"
                            Content="⬇ Descargar .zip"
                            Height="40" MinWidth="140"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Background="#10B981"
                            BorderBrush="#059669"
                            BorderThickness="1"
                            Cursor="Hand"
                            IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Botón cerrar -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="BtnCerrar"
                    Content="Cerrar"
                    Height="40" Width="160"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="#E2E8F0"
                    Background="#162238"
                    BorderBrush="#2A4365"
                    BorderThickness="1"
                    Cursor="Hand"
                    HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
