<Window x:Class="Visor3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual P2P 3D Oficial — con Lucía 3D"
        Width="1120" Height="630"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Topmost="False"
        WindowStyle="ThreeDBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Estilo con placeholder para TxtUrlAmigo -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#3A5A78"
                                           FontStyle="Italic"
                                           FontSize="10"
                                           Padding="5,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Área 3D central / Área de bienvenida -->
            <RowDefinition Height="*"/>
            <!-- Barra inferior (oculta en pantalla de bienvenida) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 1. PANTALLA DE BIENVENIDA (Inicial)                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelBienvenida" Grid.Row="1" Background="#0A0C12" Visibility="Collapsed">
            <!-- Efecto de gradiente radial de fondo sutil -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#0F1420"
                    BorderBrush="#1D3557"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="44,32"
                    MaxWidth="540">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <!-- Título del metaverso oficial -->
                    <TextBlock Text="WOLD VIRTUAL P2P 3D — OFICIAL"
                               Foreground="#00D9FF"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,6"/>

                    <!-- Lucía 3D — anfitriona oficial del metaverso -->
                    <TextBlock Text="✦ Lucía 3D · Anfitriona Oficial del Metaverso ✦"
                               Foreground="#C084FC"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Sistema Oficial de Cuenta Inmutable por Bloque (Blockchain PoNL)"
                               Foreground="#8892B0"
                               FontSize="11.5"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,18"/>

                    <!-- Tarjeta de Estado del Servidor Oficial de Blockchain y Cuenta -->
                    <Border x:Name="BordeEstadoSistemaOficial"
                            Background="#09111E"
                            BorderBrush="#1E3A8A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Estado del servidor blockchain -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <Ellipse x:Name="IndicadorServidorLed" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtEstadoServidorBlockchain"
                                           Text="⚡ Servidor Blockchain Oficial: Comprobando puerto 8545..."
                                           Foreground="#6EE7B7"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Estado de la cuenta oficial -->
                            <Border Background="#050B14" BorderBrush="#162D4A" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel>
                                    <TextBlock x:Name="TxtEstadoCuentaOficial"
                                               Text="👤 Verificando cuenta oficial..."
                                               Foreground="#93C5FD"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtDetalleCuentaOficial"
                                               Text="Una cuenta = un bloque inmutable (sin contraseñas)."
                                               Foreground="#94A3B8"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Estado de la red P2P antes de entrar: vacío u ocupado -->
                    <Border x:Name="BordeEstadoRed"
                            Background="#0A1524"
                            BorderBrush="#1D3A5C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="TxtEstadoRed"
                                       Text="Buscando nodos en tu red…"
                                       Foreground="#7ECFFF"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtDetalleRed"
                                       Text="Si no hay nadie, entrarás como primero de la sesión."
                                       Foreground="#8892B0"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="BtnBuscarRed"
                                        Content="Buscar de nuevo"
                                        Width="120" Height="22"
                                        FontSize="10"
                                        Foreground="#8892B0"
                                        Background="#101A2A"
                                        BorderBrush="#1D3A5C"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <Button x:Name="BtnUsarNodoRed"
                                        Content="Usar este nodo"
                                        Width="110" Height="22"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="#00D9FF"
                                        Background="#0A1E30"
                                        BorderBrush="#00D9FF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        Margin="8,0,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Botón Principal: Entrar al Metaverso con Lucía 3D -->
                    <Button x:Name="BtnCrearCuenta"
                            Content="✦ Entrar al Metaverso con Lucía 3D ✦"
                            Width="300" Height="44"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Background="#0284C7"
                            BorderBrush="#38BDF8"
                            BorderThickness="1.5"
                            Cursor="Hand"
                            Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botón Oficina de Lucía 3D (Recepción, cambio de avatar y estado de cuenta) -->
                    <Button x:Name="BtnOficinaLucia"
                            Content="✦ Oficina de Lucía 3D (Recepción y Avatares)"
                            Width="300" Height="32"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="#E0E7FF"
                            Background="#1E1B4B"
                            BorderBrush="#4338CA"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,0,8">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Fila inferior: Importar y Avanzado -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <!-- Importar cuenta .zip -->
                        <Button x:Name="BtnImportarCuenta"
                                Content="📥 Importar .zip / cuenta"
                                Width="146" Height="28"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="#7DD3FC"
                                Background="#0C2036"
                                BorderBrush="#0369A1"
                                BorderThickness="1"
                                Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Botón Acceso avanzado (conectar a IP manual / legacy) -->
                        <Button x:Name="BtnAcceder"
                                Content="⚙ Conectar a IP..."
                                Width="146" Height="28"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="#94A3B8"
                                Background="#162238"
                                BorderBrush="#2A4365"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Botón oculto para compatibilidad XAML -->
                    <Button x:Name="BtnMigrarCuenta" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 2. VISTA DEL MUNDO 3D (Se muestra tras acceder)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelMundo3D" Grid.Row="1" Visibility="Visible" Background="#050811">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>  <!-- Barra superior de sesión -->
                <RowDefinition Height="*"/>   <!-- Viewport / HUD 3D -->
                <RowDefinition Height="Auto"/> <!-- Barra inferior de chat -->
            </Grid.RowDefinitions>

            <!-- Barra superior de sesión autenticada (zona WPF pura: aquí vive todo lo flotante) -->
            <Grid Grid.Row="0">
            <Border Background="#0A0F1D" BorderBrush="#163B67" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: nombre y estado -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 WOLD VIRTUAL OFICIAL" Foreground="#00D9FF" FontSize="12.5" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Border Background="#162238" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtSesionUsuario" Text="Usuario: ---" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BordeEstadoP2P" Background="#1A2A1A" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtEstadoP2P" Text="⏳ Red P2P: iniciando..." Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BordeEstadoBlockchainTop" Background="#064E3B" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtEstadoBlockchainTop" Text="⚡ Blockchain: 8545" Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BordeEstadoLuciaTop" Background="#3B0764" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtEstadoLuciaTop" Text="🧠 LucIA: iniciando" Foreground="#F5D0FE" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="BtnVolverLucia"
                                Content="✦ Lucía 3D"
                                Height="24" Padding="7,1"
                                FontSize="10.5" FontWeight="SemiBold"
                                Foreground="#F5D0FE" Background="#4A044E"
                                BorderBrush="#A21CAF" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,6,0"
                                ToolTip="Volver a la recepción de Lucía 3D para cambiar de avatar o ver tu bloque de cuenta">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnOficinaAvatar"
                                Content="✦ Oficina con avatar"
                                Height="24" Padding="7,1"
                                FontSize="10.5" FontWeight="SemiBold"
                                Foreground="#DDD6FE" Background="#2E1065"
                                BorderBrush="#8B5CF6" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,6,0"
                                ToolTip="Entrar en la oficina de LucIA con tu avatar visible">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnInvitarLucia"
                                Content="✦ Invitar a LucIA"
                                Height="24" Padding="7,1"
                                FontSize="10.5" FontWeight="SemiBold"
                                Foreground="#FBCFE8" Background="#500724"
                                BorderBrush="#DB2777" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,6,0"
                                ToolTip="Llevar a LucIA a tu isla para acompañarte">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnConstruir"
                                Content="🏗 Construcción"
                                Height="24" Padding="7,1"
                                FontSize="10.5" FontWeight="SemiBold"
                                Foreground="#FDE68A" Background="#451A03"
                                BorderBrush="#F59E0B" BorderThickness="1"
                                Cursor="Hand" Margin="0,0,6,0"
                                ToolTip="Abrir Godot para construir y llevar la escena a tu isla">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Centro: enlace P2P propio + WebNodo -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="BannerP2P" Visibility="Collapsed"
                                Background="#0D2137" BorderBrush="#00D9FF" BorderThickness="1"
                                CornerRadius="4" Padding="10,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtEtiquetaEnlace" Text="🔗 Tu enlace P2P: " Foreground="#8892B0" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUrlP2P" Text="" Foreground="#00D9FF" FontSize="10.5" FontFamily="Consolas"
                                           FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                           MaxWidth="420" TextTrimming="CharacterEllipsis"
                                           ToolTip="Haz clic para copiar y comparte este enlace por WhatsApp con un amigo"/>
                                <TextBlock Text=" " Width="6"/>
                                <Button x:Name="BtnCopiarUrlP2P"
                                        Content="📋 Copiar"
                                        Height="20" Padding="6,1"
                                        FontSize="10" FontWeight="SemiBold"
                                        Foreground="#00D9FF" Background="#0F2744"
                                        BorderBrush="#00D9FF" BorderThickness="1"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- WebNodo: portal de descarga del visor para amigos -->
                        <Button x:Name="BtnWebNodo"
                                Content="🌐 WebNodo"
                                Height="24" Padding="8,1"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#00D9FF" Background="#0F2744"
                                BorderBrush="#00D9FF" BorderThickness="1"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                ToolTip="Abre el portal de descarga del visor (WebNodo) para compartirlo con tus amigos">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Chat de texto, voz y webcam del metaverso -->
                        <Button x:Name="BtnChat"
                                Content="💬 Chat"
                                Height="24" Padding="8,1"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#7CE7C0" Background="#0F2A24"
                                BorderBrush="#2DD4BF" BorderThickness="1"
                                Cursor="Hand"
                                Margin="6,0,0,0"
                                ToolTip="Abrir el chat del metaverso (texto, voz y webcam)">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Solo aparece si el proceso de Godot muere: reincrustar sin cerrar el visor -->
                        <Button x:Name="BtnReiniciar3D"
                                Content="⟳ Reiniciar 3D"
                                Height="24" Padding="8,1"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#FCD34D" Background="#2A2110"
                                BorderBrush="#B45309" BorderThickness="1"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="El motor 3D se detuvo. Pulsa para volver a incrustarlo sin cerrar el visor.">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Diagnóstico: copia versión, estado y log al portapapeles -->
                        <Button x:Name="BtnDiagnostico"
                                Content="ⓘ"
                                Width="24" Height="24" Padding="0"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#94A3B8" Background="Transparent"
                                BorderBrush="#1D3A5C" BorderThickness="1"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                ToolTip="Copiar diagnóstico (versión, estado y últimas líneas del log)">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Derecha: actualización, llave y cerrar sesión -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Actualización: dentro de la barra (zona WPF), justo antes de la llave -->
                        <Button x:Name="BtnActualizar"
                                Height="26" MinWidth="108" Padding="9,0" Margin="0,0,10,0"
                                VerticalAlignment="Center" Cursor="Hand"
                                Background="#0F2744" BorderBrush="#1D3A5C" BorderThickness="1"
                                Foreground="#7ECFFF" FontSize="10" FontWeight="SemiBold"
                                ToolTipService.ShowDuration="20000"
                                ToolTip="Buscando actualizaciones…"
                                AutomationProperties.Name="Actualizar el visor"
                                Click="OnActualizarClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Marco" CornerRadius="13"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="#00D9FF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Marco" Property="Background" Value="#0B2A46"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Marco" Property="Opacity" Value="0.65"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BtnActualizarVisual" Width="16" Height="16" Background="Transparent">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="GlowActualizar" Color="#38BDF8"
                                                          BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Path x:Name="IconoDescarga" Data="M12,2V13M12,13L7,8M12,13L17,8M5,18H19"
                                              Stroke="#38BDF8" StrokeThickness="2" Stretch="Uniform" Margin="1"/>
                                        <Path x:Name="IconoAlDia" Data="M4,12L9,17L20,6"
                                              Stroke="#22C55E" StrokeThickness="2" Stretch="Uniform" Margin="1"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TxtEtiquetaActualizar" Text="Buscando…"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtProgresoPorcentaje" Text="0 %"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="10" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TxtSesionLlave" Text="Llave: ---" Foreground="#8892B0" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnCerrarSesion"
                                Content="Cerrar Sesión"
                                Width="95" Height="26"
                                FontSize="11"
                                Foreground="#F87171"
                                Background="#2A1215"
                                BorderBrush="#7F1D1D"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

                <!-- Progreso de descarga: 2 px en el borde inferior de la barra (nunca sobre el HwndHost) -->
                <Grid x:Name="BarProgreso" Height="2" VerticalAlignment="Bottom"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColProgreso" Width="0*"/>
                        <ColumnDefinition x:Name="ColResto" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#38BDF8"/>
                    <Border Grid.Column="1" Background="#163B67"/>
                </Grid>
            </Grid>

            <!-- Área Central 3D -->
            <Grid Grid.Row="1">
                <!-- Contenedor del HwndHost de Godot. OJO: es un HWND nativo y se pinta
                     SIEMPRE por encima del resto de WPF de esta fila (airspace). Por eso
                     el chat vive en una fila propia, debajo del motor, a todo el ancho. -->
                <Grid x:Name="ContenedorGodotMain" Background="#000000"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <Grid x:Name="PanelConstructorEditor" Visibility="Collapsed" Background="#050811">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="54"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ContenedorEditor" Grid.Row="0" Background="#0B1220"/>
                    <Border Grid.Row="1" Background="#0B1220"
                            BorderBrush="#F59E0B" BorderThickness="0,1,0,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="#FDE68A" FontSize="12"
                                       Text="Construye en Godot. La escena se guarda sola; pulsa «Llevar a mi isla» para aplicarla."/>
                            <Button x:Name="BtnUsarConstruccion" Grid.Column="1"
                                    Content="🏝 Llevar a mi isla"
                                    Height="34" Padding="14,2" Margin="8,0"
                                    Foreground="#052E16" Background="#34D399"
                                    BorderBrush="#10B981" BorderThickness="1"
                                    FontWeight="Bold" Cursor="Hand"/>
                            <Button x:Name="BtnCerrarConstructor" Grid.Column="2"
                                    Content="Cerrar constructor"
                                    Height="34" Padding="12,2"
                                    Foreground="#FCA5A5" Background="#450A0A"
                                    BorderBrush="#EF4444" BorderThickness="1"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- BARRA INFERIOR DE CHAT (texto + voz + webcam)               -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border x:Name="PanelChat" Grid.Row="2"
                    Visibility="Collapsed"
                    Height="340"
                    Background="#0A0F1D"
                    BorderBrush="#163B67"
                    BorderThickness="0,1,0,0">
                <Grid Margin="10,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💬 Chat del metaverso"
                                       Foreground="#00D9FF" FontSize="12.5" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtChatEstado" Grid.Column="1"
                                       Text="Chat desconectado"
                                       Foreground="#64748B" FontSize="9.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Estado de la conexión de chat, voz y cámara"/>
                            <Button x:Name="BtnAmigos" Grid.Column="2"
                                    Content="👥 Amigos"
                                    Height="22" Padding="6,0" Margin="0,0,6,0"
                                    FontSize="10" FontWeight="SemiBold"
                                    Foreground="#E2E8F0" Background="#111A2C"
                                    BorderBrush="#1D3A5C" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Abrir tu lista de amigos">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnChatCerrar" Grid.Column="3"
                                    Content="✕" Width="22" Height="22" Padding="0"
                                    FontSize="11" FontWeight="Bold"
                                    Foreground="#94A3B8" Background="#111A2C"
                                    BorderBrush="#1D3A5C" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Cerrar el chat">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Franja superior: todas las webcams en horizontal -->
                        <Border x:Name="MarcoVideosChat" Grid.Row="1"
                                Visibility="Collapsed"
                                Background="#050811"
                                BorderBrush="#163B67" BorderThickness="1"
                                CornerRadius="5" Padding="4"
                                Margin="0,0,0,6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PanelVideos" Orientation="Horizontal">
                                    <Border x:Name="MarcoCamLocal" Visibility="Collapsed"
                                            Background="#050811" BorderBrush="#2DD4BF" BorderThickness="1"
                                            CornerRadius="5" VerticalAlignment="Top"
                                            Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="TU CÁMARA" Foreground="#2DD4BF" FontSize="9"
                                                       FontWeight="Bold" Margin="5,3,5,0"/>
                                            <Image x:Name="ImgCamLocal" Width="160" Height="90"
                                                   Stretch="UniformToFill" Margin="4"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Contenido: lista de amigos + historial -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Amigos, solicitudes y personas conectadas en la sesión -->
                            <Border x:Name="PanelAmigos" Grid.Column="0"
                                    Visibility="Collapsed"
                                    Width="260"
                                    Background="#0D1424"
                                    BorderBrush="#1D3A5C" BorderThickness="1"
                                    CornerRadius="5" Padding="8"
                                    Margin="0,0,8,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tu código:"
                                                   Foreground="#94A3B8" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMiCodigo" Grid.Column="1"
                                                   Text="—"
                                                   Foreground="#2DD4BF" FontFamily="Consolas"
                                                   FontSize="11.5" FontWeight="Bold"
                                                   Margin="6,0,6,0" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnCopiarCodigo" Grid.Column="2"
                                                Content="Copiar" Height="22" Padding="6,0"
                                                FontSize="10" FontWeight="SemiBold"
                                                Foreground="#E2E8F0" Background="#162238"
                                                BorderBrush="#2A4365" BorderThickness="1"
                                                Cursor="Hand"
                                                ToolTip="Copiar tu código para compartirlo">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCodigoAmigo" Height="26" Padding="6,2"
                                                 MaxLength="64"
                                                 FontSize="11" Foreground="#E2E8F0"
                                                 CaretBrush="#00D9FF"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Pega el código de amigo de la otra persona">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="#111A2C"/>
                                                    <Setter Property="BorderBrush" Value="#1D3A5C"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter Property="Background" Value="#0D2137"/>
                                                            <Setter Property="BorderBrush" Value="#2DD4BF"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button x:Name="BtnAgregarAmigo" Grid.Column="1"
                                                Content="Añadir" Height="26" Padding="8,0"
                                                Margin="6,0,0,0"
                                                FontSize="10" FontWeight="Bold"
                                                Foreground="#0B1120" Background="#2DD4BF"
                                                BorderBrush="#2DD4BF" BorderThickness="1"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Pega el código de 8 caracteres de la otra persona."
                                               Foreground="#64748B" FontSize="9"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtEstadoAmigos"
                                               Foreground="#94A3B8" FontSize="9.5"
                                               TextWrapping="Wrap" Margin="0,0,0,2"/>

                                    <TextBlock x:Name="LblSolicitudes" Text="SOLICITUDES"
                                               Foreground="#FBBF24" FontSize="9" FontWeight="Bold"
                                               Margin="0,4,0,3"
                                               Visibility="Collapsed"/>
                                    <StackPanel x:Name="ListaSolicitudes"/>

                                    <TextBlock Text="AMIGOS"
                                               Foreground="#00D9FF" FontSize="9" FontWeight="Bold"
                                               Margin="0,6,0,3"/>
                                    <StackPanel x:Name="ListaAmigos"/>

                                    <TextBlock x:Name="LblEnSesion" Text="EN ESTA SESIÓN"
                                               Foreground="#94A3B8" FontSize="9" FontWeight="Bold"
                                               Margin="0,6,0,3"
                                               Visibility="Collapsed"/>
                                    <StackPanel x:Name="ListaEnSesion"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                            <!-- Historial de mensajes a todo el ancho del chat -->
                            <ListBox x:Name="ListaChat" Grid.Column="1"
                                     Background="#080C16" BorderBrush="#163B67" BorderThickness="1"
                                     Foreground="#E2E8F0" FontSize="11.5"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>

                        <!-- Voz, cámara y entrada de texto -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnChatMic" Grid.Column="0"
                                    Content="🎙 Voz"
                                    Height="28" Padding="8,1" Margin="0,0,6,0"
                                    FontSize="10.5" FontWeight="SemiBold"
                                    Foreground="#E2E8F0" Background="#162238"
                                    BorderBrush="#2A4365" BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Activar o desactivar tu micrófono">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnChatCam" Grid.Column="1"
                                    Content="📷 Cámara"
                                    Height="28" Padding="8,1" Margin="0,0,6,0"
                                    FontSize="10.5" FontWeight="SemiBold"
                                    Foreground="#E2E8F0" Background="#162238"
                                    BorderBrush="#2A4365" BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Activar o desactivar tu webcam">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <ProgressBar x:Name="BarraMic" Grid.Column="2"
                                         Height="5" Minimum="0" Maximum="100" Value="0"
                                         Margin="0,0,4,0"
                                         VerticalAlignment="Center"
                                         Foreground="#2DD4BF" Background="#111A2C"
                                         BorderThickness="0"/>
                            <!-- Al hacer clic (o al abrir el chat) el cuadro se
                                 enciende: fondo más claro y borde turquesa. -->
                            <TextBox x:Name="TxtChat" Grid.Column="3"
                                     Height="28" Padding="6,3"
                                     MaxLength="500"
                                     FontSize="11.5"
                                     Foreground="#E2E8F0"
                                     CaretBrush="#00D9FF"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Escribe y pulsa Enter para enviar">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#111A2C"/>
                                        <Setter Property="BorderBrush" Value="#1D3A5C"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="#0D2137"/>
                                                <Setter Property="BorderBrush" Value="#2DD4BF"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button x:Name="BtnChatEnviar" Grid.Column="4"
                                    Content="Enviar"
                                    Height="28" Padding="10,1" Margin="6,0,0,0"
                                    FontSize="10.5" FontWeight="Bold"
                                    Foreground="#0B1120" Background="#2DD4BF"
                                    BorderBrush="#2DD4BF" BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 3. BARRA INFERIOR DE LOGIN (Solo visible al elegir Acceder) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="BarraInferiorLogin" Grid.Row="2"
                Height="40"
                Background="#0D1117"
                BorderBrush="#163B67"
                BorderThickness="0,1.5,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Botón Volver -->
                <Button x:Name="BtnVolverBienvenida"
                        Content="← Volver"
                        Width="75" Height="24"
                        FontSize="11"
                        Foreground="#8892B0"
                        Background="#161B26"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,16,0"/>

                <!-- Label Usuario -->
                <TextBlock Text="Usuario:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Usuario -->
                <TextBox x:Name="TxtLoginUser"
                         Width="130" Height="24"
                         FontSize="12"
                         Padding="4,2"
                         Background="#161B26"
                         Foreground="#E2E2E2"
                         BorderBrush="#163B67"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Label Contraseña -->
                <TextBlock Text="Contraseña:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Contraseña -->
                <PasswordBox x:Name="TxtLoginPass"
                             Width="130" Height="24"
                             FontSize="12"
                             Padding="4,2"
                             Background="#161B26"
                             Foreground="#E2E2E2"
                             BorderBrush="#163B67"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Botón Iniciar Sesión -->
                <Button x:Name="BtnLogin"
                        Content="Iniciar Sesión"
                        Width="105" Height="28"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Background="#0F3460"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Panel.ZIndex="1"
                        Margin="0,0,18,0"/>

                <!-- Separador visual -->
                <Border Width="1" Height="22" Background="#163B67" Margin="0,0,14,0"/>

                <!-- Estado de conexión: ya no se pega un enlace; LucIA es la anfitriona
                     y el botón Conectar valida que la sesión es alcanzable. -->
                <TextBlock Text="Conexión:"
                           Foreground="#64748B"
                           FontSize="11"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBox x:Name="TxtUrlAmigo"
                         Width="250" Height="24"
                         FontSize="10.5"
                         Padding="4,2"
                         Background="#0D1520"
                         Foreground="#7ECFFF"
                         BorderBrush="#1D3A5C"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         IsReadOnly="True"
                         ToolTip="Destino de la sesión resuelto por LucIA. Pulsa Conectar para validar que la conexión está disponible."
                         Tag="(LucIA resuelve el destino de la sesión)"/>
                <Button x:Name="BtnConectarAmigo"
                        Content="🔗 Validar conexión"
                        Width="104" Height="24"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="#00D9FF"
                        Background="#0A1E30"
                        BorderBrush="#00D9FF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="4,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
