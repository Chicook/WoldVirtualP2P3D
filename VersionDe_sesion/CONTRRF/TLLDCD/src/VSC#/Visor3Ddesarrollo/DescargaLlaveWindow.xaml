<Window x:Class="Visor3D.DescargaLlaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D — Descarga de «La Llave» de Acceso"
        Width="680" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        WindowStyle="ThreeDBorderWindow"
        AllowsTransparency="False"
        ResizeMode="NoResize">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="PASO FINAL: GENERACIÓN DE «LA LLAVE»"
                       Foreground="#00D9FF" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Tu identidad y frase semilla han sido verificadas. Ahora genera y guarda tu archivo de acceso maestro."
                       Foreground="#8892B0" FontSize="12.5" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Tarjeta Central de la Llave -->
        <Border Grid.Row="1"
                Background="#0F1420"
                BorderBrush="#1D3557"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="22">
            <StackPanel VerticalAlignment="Center">
                <Border Background="#162238" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="👤 Usuario: " Foreground="#8892B0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUsuario" Text="---" Foreground="#00D9FF" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="HASH CRIPTOGRÁFICO DE LA LLAVE:"
                           Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="#0A0D14" BorderBrush="#163B67" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                    <TextBlock x:Name="TxtHashLlave" Text="Calculando..." Foreground="#38BDF8" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="📁 Copia local guardada automáticamente en:" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="test_user_data\user\llave_acceso.json" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" Margin="0,0,0,16"/>

                <Button x:Name="BtnDescargarLlave"
                        Content="⬇ Descargar Copia Adicional (.json)"
                        Height="38"
                        FontSize="12.5" FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Background="#0077B6"
                        BorderBrush="#0096C7"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- Botón para ir al Login -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="BtnFinalizar"
                    Content="🔐 Ir a Iniciar Sesión (Meter la Llave) →"
                    Height="42"
                    FontSize="13.5" FontWeight="Bold"
                    Foreground="#FFFFFF"
                    Background="#10B981"
                    BorderBrush="#059669"
                    BorderThickness="1"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
