<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Platforms>x64</Platforms>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <AssemblyName>Visor3D</AssemblyName>
    <RootNamespace>Visor3D</RootNamespace>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <Title>Wold Virtual p2p 3D</Title>
    <Description>Visor 3D — estructura base (Fase 0)</Description>
  </PropertyGroup>

  <!--
    Fase 0: solo estructura WPF + login.
    El motor 3D (Godot incrustado / Silk.NET) y la red P2P se añaden en fases posteriores.
  -->

  <!-- Recursos web (para fases posteriores) -->
  <ItemGroup>
    <None Update="www\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>