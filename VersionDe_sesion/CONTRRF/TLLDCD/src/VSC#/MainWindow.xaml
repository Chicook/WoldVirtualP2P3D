<Window x:Class="Visor3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D"
        Width="1120" Height="630"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Topmost="False"
        WindowStyle="ThreeDBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Área 3D central / Área de bienvenida -->
            <RowDefinition Height="*"/>
            <!-- Barra inferior (oculta en pantalla de bienvenida) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 1. PANTALLA DE BIENVENIDA (Inicial)                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelBienvenida" Grid.Row="1" Background="#0A0C12">
            <!-- Efecto de gradiente radial de fondo sutil -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#0F1420"
                    BorderBrush="#1D3557"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="48,40"
                    MaxWidth="520">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <!-- Título del metaverso -->
                    <TextBlock Text="WOLD VIRTUAL P2P 3D"
                               Foreground="#00D9FF"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Bienvenido a el metaverso p2p descentralizado"
                               Foreground="#8892B0"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,32"/>

                    <!-- Botón Crear Cuenta -->
                    <Button x:Name="BtnCrearCuenta"
                            Content="Crear Cuenta"
                            Width="260" Height="42"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Background="#0077B6"
                            BorderBrush="#0096C7"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,0,14">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botón Acceder -->
                    <Button x:Name="BtnAcceder"
                            Content="Acceder"
                            Width="260" Height="42"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#E2E8F0"
                            Background="#162238"
                            BorderBrush="#2A4365"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 2. VISTA DEL MUNDO 3D (Se muestra tras acceder)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="PanelMundo3D" Grid.Row="1"
                Background="#000000"
                BorderBrush="#163B67"
                BorderThickness="0,1,0,1"
                Visibility="Collapsed">
            <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="[ MOTOR 3D — WOLD VIRTUAL P2P 3D ]"
                           Foreground="#163B67"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Opacity="0.5"/>
            </Viewbox>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 3. BARRA INFERIOR DE LOGIN (Solo visible al elegir Acceder) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="BarraInferiorLogin" Grid.Row="2"
                Height="40"
                Background="#0D1117"
                BorderBrush="#163B67"
                BorderThickness="0,1.5,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Botón Volver -->
                <Button x:Name="BtnVolverBienvenida"
                        Content="← Volver"
                        Width="75" Height="24"
                        FontSize="11"
                        Foreground="#8892B0"
                        Background="#161B26"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,16,0"/>

                <!-- Label Usuario -->
                <TextBlock Text="Usuario:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Usuario -->
                <TextBox x:Name="TxtLoginUser"
                         Width="130" Height="24"
                         FontSize="12"
                         Padding="4,2"
                         Background="#161B26"
                         Foreground="#E2E2E2"
                         BorderBrush="#163B67"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Label Contraseña -->
                <TextBlock Text="Contraseña:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Contraseña -->
                <PasswordBox x:Name="TxtLoginPass"
                             Width="130" Height="24"
                             FontSize="12"
                             Padding="4,2"
                             Background="#161B26"
                             Foreground="#E2E2E2"
                             BorderBrush="#163B67"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Botón Iniciar Sesión -->
                <Button x:Name="BtnLogin"
                        Content="Iniciar Sesión"
                        Width="105" Height="28"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Background="#0F3460"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Panel.ZIndex="1"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
