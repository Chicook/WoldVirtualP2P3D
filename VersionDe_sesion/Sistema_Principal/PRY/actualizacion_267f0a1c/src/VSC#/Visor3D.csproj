<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Platforms>x64</Platforms>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <AssemblyName>DMWoldVirtualP2P3Dv2.6.7</AssemblyName>
    <RootNamespace>Visor3D</RootNamespace>

    <Version>2.6.7</Version>
    <AssemblyVersion>2.6.7.0</AssemblyVersion>
    <FileVersion>2.6.7.0</FileVersion>

    <Title>Wold Virtual p2p 3D</Title>
    <Description>Visor 3D — DMWoldVirtualP2P3D v2.6.7 (restaura el chat completo de la 2.6.4 —texto, amigos, voz y webcam en la franja del chat— y mantiene el perfil persistente, una cuenta por PC, el diagnóstico de cuenta, el reset total único y el registro directo cuando el PC está vacío; integra el sistema de seguridad SMTPLC de la 2.6.5 —anti-VM, anti-VPN y anti-multicuenta por ubicación— con la detección de presencia P2P en la bienvenida; motor 3D y mundo en PCK intactos)</Description>
  </PropertyGroup>

  <!--
    Fase 0: solo estructura WPF + login.
    El motor 3D (Godot incrustado / Silk.NET) y la red P2P se añaden en fases posteriores.
  -->

  <!-- Excluir subcarpetas que son proyectos hermanos o carpetas de descargas -->
  <ItemGroup>
    <Compile Remove="version_prueba\**" />
    <EmbeddedResource Remove="version_prueba\**" />
    <None Remove="version_prueba\**" />
    <Page Remove="version_prueba\**" />
    <Compile Remove="webnodo\descargas\**" />
    <EmbeddedResource Remove="webnodo\descargas\**" />
    <None Remove="webnodo\descargas\**" />
    <Compile Remove="webnodo\node_modules\**" />
    <EmbeddedResource Remove="webnodo\node_modules\**" />
    <None Remove="webnodo\node_modules\**" />
  </ItemGroup>

  <!-- Dependencias -->
  <ItemGroup>
    <!-- WMI: lectura de hardware (CPU, placa base, SO) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Chat de voz: captura/reproducción PCM de baja latencia -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- Chat de webcam: captura DirectShow y compresión JPEG -->
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
  </ItemGroup>

  <!-- Recursos web (para fases posteriores y WebNodo) -->
  <ItemGroup>
    <None Update="webnodo\public\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="www\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Recursos embebidos para distribución standalone en un único .exe -->
  <ItemGroup>
    <EmbeddedResource Include="Seguridad\bip39-english.txt" />
    <EmbeddedResource Include="webnodo\public\index.html" />
    <EmbeddedResource Include="webnodo\public\metaverso.jpg" />
    <!-- Interruptor de desarrollo: -p:SkipGodotAssets=true compila la UI sin el motor ni el mundo.
         La build de distribución NO define la propiedad, así que los incluye. -->
    <EmbeddedResource Include="godot_exe.zip" Condition="'$(SkipGodotAssets)' != 'true'" />
    <EmbeddedResource Include="wvp3d.pck" Condition="'$(SkipGodotAssets)' != 'true'" />
  </ItemGroup>

</Project>