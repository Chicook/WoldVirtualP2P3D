<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Platforms>x64</Platforms>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <AssemblyName>DMWoldVirtualP2P3Dv2.6.9</AssemblyName>
    <RootNamespace>Visor3D</RootNamespace>

    <Version>2.6.9</Version>
    <AssemblyVersion>2.6.9.0</AssemblyVersion>
    <FileVersion>2.6.9.0</FileVersion>

    <Title>Wold Virtual p2p 3D</Title>
    <Description>Visor 3D — DMWoldVirtualP2P3D v2.6.9 (todo lo de la 2.6.8 —chat completo con texto, amigos, voz y webcam, perfil persistente, una cuenta por PC, reset total único, registro directo con el PC vacío, bienvenida con presencia P2P y SMTPLC sin el falso positivo de VBS— más el arreglo de la webcam: puntúa los dispositivos para empezar por el hardware real, comprueba que llega la primera trama antes de dar la cámara por buena, conmuta al siguiente candidato si no llega, vigila las caídas y explica por qué no hay imagen —Wine, permiso de privacidad o cámara virtual sin tramas—; motor 3D y mundo en PCK idénticos a los de la 2.6.1-2.6.8, sin reexportar)</Description>
  </PropertyGroup>

  <!--
    Sin esto, .NET 8 carga el ICU del sistema al arrancar. Bajo Wine el icu.dll
    reenvía a un icuuc68 que no existe y el proceso muere con código 127 antes
    de ejecutar código propio. Con System.Globalization.UseNls .NET usa las API
    de locale de kernel32 (que Wine sí implementa) y en Windows conserva la
    cultura es-ES: fechas 29/10/2026, decimales con coma y orden alfabético.
    No se usa InvariantGlobalization: en modo invariante `new CultureInfo("es-ES")`
    lanza CultureNotFoundException y las fechas pasan a formato MM/dd/yyyy.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!--
    Fase 0: solo estructura WPF + login.
    El motor 3D (Godot incrustado / Silk.NET) y la red P2P se añaden en fases posteriores.
  -->

  <!-- Excluir subcarpetas que son proyectos hermanos o carpetas de descargas -->
  <ItemGroup>
    <Compile Remove="version_prueba\**" />
    <EmbeddedResource Remove="version_prueba\**" />
    <None Remove="version_prueba\**" />
    <Page Remove="version_prueba\**" />
    <Compile Remove="webnodo\descargas\**" />
    <EmbeddedResource Remove="webnodo\descargas\**" />
    <None Remove="webnodo\descargas\**" />
    <Compile Remove="webnodo\node_modules\**" />
    <EmbeddedResource Remove="webnodo\node_modules\**" />
    <None Remove="webnodo\node_modules\**" />
  </ItemGroup>

  <!-- Dependencias -->
  <ItemGroup>
    <!-- WMI: lectura de hardware (CPU, placa base, SO) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Chat de voz: captura/reproducción PCM de baja latencia -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- Chat de webcam: captura DirectShow y compresión JPEG -->
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
  </ItemGroup>

  <!-- Recursos web (para fases posteriores y WebNodo) -->
  <ItemGroup>
    <None Update="webnodo\public\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="www\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Recursos embebidos para distribución standalone en un único .exe -->
  <ItemGroup>
    <EmbeddedResource Include="Seguridad\bip39-english.txt" />
    <EmbeddedResource Include="webnodo\public\index.html" />
    <EmbeddedResource Include="webnodo\public\metaverso.jpg" />
    <!-- Interruptor de desarrollo: -p:SkipGodotAssets=true compila la UI sin el motor ni el mundo.
         La build de distribución NO define la propiedad, así que los incluye. -->
    <EmbeddedResource Include="godot_exe.zip" Condition="'$(SkipGodotAssets)' != 'true'" />
    <EmbeddedResource Include="wvp3d.pck" Condition="'$(SkipGodotAssets)' != 'true'" />
  </ItemGroup>

</Project>