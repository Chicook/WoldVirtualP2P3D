<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Platforms>x64</Platforms>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <AssemblyName>DMWoldVirtualp2pCNXv0.0.012_actualizacion_049ac229</AssemblyName>
    <RootNamespace>Visor3D</RootNamespace>

    <Version>0.0.012</Version>
    <AssemblyVersion>0.0.12.0</AssemblyVersion>
    <FileVersion>0.0.12.0</FileVersion>

    <Title>Wold Virtual p2p 3D</Title>
    <Description>Visor 3D — actualizacion_049ac229 (DMWoldVirtualp2pCNX v0.0.012)</Description>
  </PropertyGroup>

  <!--
    Fase 0: solo estructura WPF + login.
    El motor 3D (Godot incrustado / Silk.NET) y la red P2P se añaden en fases posteriores.
  -->

  <!-- Excluir subcarpetas que son proyectos hermanos o carpetas de descargas -->
  <ItemGroup>
    <Compile Remove="version_prueba\**" />
    <EmbeddedResource Remove="version_prueba\**" />
    <None Remove="version_prueba\**" />
    <Page Remove="version_prueba\**" />
    <Compile Remove="webnodo\descargas\**" />
    <EmbeddedResource Remove="webnodo\descargas\**" />
    <None Remove="webnodo\descargas\**" />
    <Compile Remove="webnodo\node_modules\**" />
    <EmbeddedResource Remove="webnodo\node_modules\**" />
    <None Remove="webnodo\node_modules\**" />
  </ItemGroup>

  <!-- Dependencias -->
  <ItemGroup>
    <!-- WMI: lectura de hardware (CPU, placa base, SO) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Recursos web (para fases posteriores y WebNodo) -->
  <ItemGroup>
    <None Update="webnodo\public\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="www\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Recursos embebidos para distribución standalone en un único .exe -->
  <ItemGroup>
    <EmbeddedResource Include="webnodo\public\index.html" />
    <EmbeddedResource Include="webnodo\public\metaverso.jpg" />
    <EmbeddedResource Include="godot_exe.zip" />
    <EmbeddedResource Include="godot_project.zip" />
  </ItemGroup>

</Project>