<Window x:Class="Visor3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D"
        Width="1120" Height="630"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Topmost="False"
        WindowStyle="ThreeDBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Estilo con placeholder para TxtUrlAmigo -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#3A5A78"
                                           FontStyle="Italic"
                                           FontSize="10"
                                           Padding="5,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Área 3D central / Área de bienvenida -->
            <RowDefinition Height="*"/>
            <!-- Barra inferior (oculta en pantalla de bienvenida) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 1. PANTALLA DE BIENVENIDA (Inicial)                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelBienvenida" Grid.Row="1" Background="#0A0C12">
            <!-- Efecto de gradiente radial de fondo sutil -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#0F1420"
                    BorderBrush="#1D3557"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="48,40"
                    MaxWidth="520">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <!-- Título del metaverso -->
                    <TextBlock Text="WOLD VIRTUAL P2P 3D"
                               Foreground="#00D9FF"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Bienvenido a el metaverso p2p descentralizado"
                               Foreground="#8892B0"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,32"/>

                    <!-- Botón Crear Cuenta -->
                    <Button x:Name="BtnCrearCuenta"
                            Content="Crear Cuenta"
                            Width="260" Height="42"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Background="#0077B6"
                            BorderBrush="#0096C7"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,0,14">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botón Acceder -->
                    <Button x:Name="BtnAcceder"
                            Content="Acceder"
                            Width="260" Height="42"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#E2E8F0"
                            Background="#162238"
                            BorderBrush="#2A4365"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 2. VISTA DEL MUNDO 3D (Se muestra tras acceder)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelMundo3D" Grid.Row="1" Visibility="Collapsed" Background="#050811">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>  <!-- Barra superior de sesión -->
                <RowDefinition Height="*"/>   <!-- Viewport / HUD 3D -->
            </Grid.RowDefinitions>

            <!-- Barra superior de sesión autenticada -->
            <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#163B67" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: nombre y estado -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 WOLD VIRTUAL P2P" Foreground="#00D9FF" FontSize="13" FontWeight="Bold" Margin="0,0,12,0"/>
                        <Border Background="#162238" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtSesionUsuario" Text="Usuario: ---" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BordeEstadoP2P" Background="#1A2A1A" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtEstadoP2P" Text="⏳ Red P2P: iniciando..." Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Centro: enlace P2P propio + WebNodo -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="BannerP2P" Visibility="Collapsed"
                                Background="#0D2137" BorderBrush="#00D9FF" BorderThickness="1"
                                CornerRadius="4" Padding="10,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔗 Tu enlace P2P: " Foreground="#8892B0" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUrlP2P" Text="" Foreground="#00D9FF" FontSize="10.5" FontFamily="Consolas"
                                           FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                           ToolTip="Haz clic para copiar y comparte este enlace por WhatsApp con un amigo"/>
                                <TextBlock Text=" " Width="6"/>
                                <Button x:Name="BtnCopiarUrlP2P"
                                        Content="📋 Copiar"
                                        Height="20" Padding="6,1"
                                        FontSize="10" FontWeight="SemiBold"
                                        Foreground="#00D9FF" Background="#0F2744"
                                        BorderBrush="#00D9FF" BorderThickness="1"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- WebNodo: portal de descarga del visor para amigos -->
                        <Button x:Name="BtnWebNodo"
                                Content="🌐 WebNodo"
                                Height="24" Padding="8,1"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#00D9FF" Background="#0F2744"
                                BorderBrush="#00D9FF" BorderThickness="1"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                ToolTip="Abre el portal de descarga del visor (WebNodo) para compartirlo con tus amigos">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Derecha: llave y cerrar sesión -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSesionLlave" Text="Llave: ---" Foreground="#8892B0" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="BtnCerrarSesion"
                                Content="Cerrar Sesión"
                                Width="95" Height="26"
                                FontSize="11"
                                Foreground="#F87171"
                                Background="#2A1215"
                                BorderBrush="#7F1D1D"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Área Central 3D / HUD del Metaverso -->
            <Grid Grid.Row="1">
                <!-- Grid contenedor para HwndHost de Godot — Children.Add desde code-behind -->
                <Grid x:Name="ContenedorGodotMain" Background="#000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- HUD flotante superpuesto minimalista -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="#CC0A0F1D" BorderBrush="#163B67" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,16,16" IsHitTestVisible="False">
                    <StackPanel>
                        <TextBlock Text="✦ SESIÓN METAVERSO 3D ACTIVA ✦" Foreground="#00D9FF" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Escena: WoldVirtual3DP2P.tscn" Foreground="#8892B0" FontSize="10.5"/>
                        <TextBlock Text="Red P2P DeFi Enlazada" Foreground="#22C55E" FontSize="10.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 3. BARRA INFERIOR DE LOGIN (Solo visible al elegir Acceder) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="BarraInferiorLogin" Grid.Row="2"
                Height="40"
                Background="#0D1117"
                BorderBrush="#163B67"
                BorderThickness="0,1.5,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Botón Volver -->
                <Button x:Name="BtnVolverBienvenida"
                        Content="← Volver"
                        Width="75" Height="24"
                        FontSize="11"
                        Foreground="#8892B0"
                        Background="#161B26"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,16,0"/>

                <!-- Label Usuario -->
                <TextBlock Text="Usuario:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Usuario -->
                <TextBox x:Name="TxtLoginUser"
                         Width="130" Height="24"
                         FontSize="12"
                         Padding="4,2"
                         Background="#161B26"
                         Foreground="#E2E2E2"
                         BorderBrush="#163B67"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Label Contraseña -->
                <TextBlock Text="Contraseña:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Contraseña -->
                <PasswordBox x:Name="TxtLoginPass"
                             Width="130" Height="24"
                             FontSize="12"
                             Padding="4,2"
                             Background="#161B26"
                             Foreground="#E2E2E2"
                             BorderBrush="#163B67"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Botón Iniciar Sesión -->
                <Button x:Name="BtnLogin"
                        Content="Iniciar Sesión"
                        Width="105" Height="28"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Background="#0F3460"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Panel.ZIndex="1"
                        Margin="0,0,18,0"/>

                <!-- Separador visual -->
                <Border Width="1" Height="22" Background="#163B67" Margin="0,0,14,0"/>

                <!-- Campo URL de amigo -->
                <TextBlock Text="Web amigo:"
                           Foreground="#64748B"
                           FontSize="11"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBox x:Name="TxtUrlAmigo"
                         Width="250" Height="24"
                         FontSize="10.5"
                         Padding="4,2"
                         Background="#0D1520"
                         Foreground="#7ECFFF"
                         BorderBrush="#1D3A5C"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         Style="{StaticResource PlaceholderTextBoxStyle}"
                         ToolTip="Pega aquí el enlace P2P que te compartió un amigo. Si no tienes, inicia sesión directamente."
                         Tag="(llellenalo si tienes web de un amigo, si no inicia sesion)"/>
                <Button x:Name="BtnConectarAmigo"
                        Content="🔗 Conectar"
                        Width="80" Height="24"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="#00D9FF"
                        Background="#0A1E30"
                        BorderBrush="#00D9FF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="4,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
