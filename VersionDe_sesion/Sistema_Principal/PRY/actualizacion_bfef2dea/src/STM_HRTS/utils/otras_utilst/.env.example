# WoldVirtualP2P3D — ejemplo de configuración local
#
# Copia este fichero como .env, rellena los valores reales y NO lo subas nunca:
# el repositorio es PÚBLICO y .env está ignorado por .git (.gitignore, sección 12).
#
# Nada carga este fichero automáticamente todavía: exporta las variables que
# necesites (o haz `source .env` tras limpiar retornos de carro) antes de
# ejecutar LucIA o las herramientas que las leen. Los nombres son exactamente
# los que lee el código.

# ── Acceso LLM de LucIA ──────────────────────────────────────────────────────
# Leída por src/SBSTM/IAFREE.py y src/STM_SGR/vault_openrouter.py.
OPENROUTER_API_KEY=sk-or-v1-REEMPLAZAME

# Contraseña maestra del almacén de la clave (src/STM_SGR/vault_openrouter.py).
# Si no se fija, el almacén cae a una semilla interna: vale para pruebas,
# no para una clave real.
OPENROUTER_VAULT_PW=REEMPLAZAME

# ── Rutas de herramientas (src/STM_HRTS/rutas.py) ────────────────────────────
# Solo hacen falta si Godot/dotnet no están en el PATH.
#GODOT_BIN=/ruta/a/Godot_v4.7.2-stable_linux.x86_64
#DOTNET_BIN=/ruta/a/dotnet
