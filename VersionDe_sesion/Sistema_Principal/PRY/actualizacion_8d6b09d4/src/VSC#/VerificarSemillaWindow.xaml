<Window x:Class="Visor3D.VerificarSemillaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D — Verificación de Semilla"
        Width="580" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C12"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanMinimize">

    <Grid Margin="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Título -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Descripción -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Panel campos de verificación -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Botón Verificar -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Mensajes de estado -->
        </Grid.RowDefinitions>

        <!-- ── Título ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Verificar Frase Semilla"
                       Foreground="#00D9FF"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Paso 4 de 5 — Comprobación de seguridad de tu wallet DeFi"
                       Foreground="#8892B0"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Descripción ── -->
        <Border Grid.Row="2"
                Background="#0F1420"
                BorderBrush="#1D3557"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10">
            <TextBlock Foreground="#CBD5E1"
                       FontSize="11"
                       LineHeight="17"
                       TextWrapping="Wrap">
                Para verificar que has respaldado tu archivo <Run Foreground="#00D9FF" FontWeight="Bold">semilla_wallet.json</Run> correctamente, escribe las 3 palabras solicitadas en minúsculas:
            </TextBlock>
        </Border>

        <!-- ── Panel de las 3 palabras a verificar ── -->
        <Border Grid.Row="4"
                Background="#0F1420"
                BorderBrush="#1D3557"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Palabra 1 -->
                <TextBlock x:Name="LblPalabra1"
                           Grid.Row="0" Grid.Column="0"
                           Text="Palabra #?:"
                           Foreground="#8892B0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPalabra1"
                         Grid.Row="0" Grid.Column="1"
                         Height="30" FontSize="12"
                         Padding="8,4"
                         Background="#161B26"
                         Foreground="#E2E8F0"
                         BorderBrush="#2A4365"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>

                <!-- Palabra 2 -->
                <TextBlock x:Name="LblPalabra2"
                           Grid.Row="2" Grid.Column="0"
                           Text="Palabra #?:"
                           Foreground="#8892B0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPalabra2"
                         Grid.Row="2" Grid.Column="1"
                         Height="30" FontSize="12"
                         Padding="8,4"
                         Background="#161B26"
                         Foreground="#E2E8F0"
                         BorderBrush="#2A4365"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>

                <!-- Palabra 3 -->
                <TextBlock x:Name="LblPalabra3"
                           Grid.Row="4" Grid.Column="0"
                           Text="Palabra #?:"
                           Foreground="#8892B0" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPalabra3"
                         Grid.Row="4" Grid.Column="1"
                         Height="30" FontSize="12"
                         Padding="8,4"
                         Background="#161B26"
                         Foreground="#E2E8F0"
                         BorderBrush="#2A4365"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Botón Verificar ── -->
        <Button x:Name="BtnVerificar"
                Grid.Row="6"
                Content="Verificar palabras y continuar  →"
                Height="42"
                FontSize="13.5"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Background="#0077B6"
                BorderBrush="#0096C7"
                BorderThickness="1"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- ── Mensajes de error y éxito ── -->
        <StackPanel Grid.Row="8" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtError"
                       Foreground="#F87171"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="TxtExito"
                       Text="✔ ¡Verificación correcta! Generando tu Llave de acceso..."
                       Foreground="#22C55E"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
