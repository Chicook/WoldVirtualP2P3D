<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Platforms>x64</Platforms>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <!-- El numero viene de src/VERSION.json via Directory.Build.props (U5.1). No escribir 2.x aqui. -->
    <AssemblyName>DMWoldVirtualP2P3Dv$(WoldVersion)</AssemblyName>
    <RootNamespace>Visor3D</RootNamespace>

    <Version>$(WoldVersion)</Version>
    <AssemblyVersion>$(WoldVersion).0</AssemblyVersion>
    <FileVersion>$(WoldVersion).0</FileVersion>

    <Title>Wold Virtual p2p 3D</Title>
    <Description>Visor 3D — DMWoldVirtualP2P3D v$(WoldVersion) (todo lo de la 2.7.6 más la unificación del tronco con la rama de utillaje del 2026-11-05: el visor recupera el chat por token de sesión del tronco —TokenSesionChat, enlazado desde el portal— y las fuentes Python y de arte de stage1; el portal ya no cablea el número de versión, la deriva del ensamblado (InformationalVersion y, si falta, AssemblyVersion); el utillaje queda empaquetado en STM_HRTS/utils/add_utils, con pytest.ini y su cache declarados desde el paquete; y se incorporan al árbol las pruebas unitarias xUnit Visor3DTests junto a la autoprueba --webnodo-selftest)</Description>
  </PropertyGroup>

  <!--
    Sin esto, .NET 8 carga el ICU del sistema al arrancar. Bajo Wine el icu.dll
    reenvía a un icuuc68 que no existe y el proceso muere con código 127 antes
    de ejecutar código propio. Con System.Globalization.UseNls .NET usa las API
    de locale de kernel32 (que Wine sí implementa) y en Windows conserva la
    cultura es-ES: fechas 29/10/2026, decimales con coma y orden alfabético.
    No se usa InvariantGlobalization: en modo invariante `new CultureInfo("es-ES")`
    lanza CultureNotFoundException y las fechas pasan a formato MM/dd/yyyy.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!--
    Fase 0: solo estructura WPF + login.
    El motor 3D (Godot incrustado / Silk.NET) y la red P2P se añaden en fases posteriores.
  -->

  <!-- Excluir subcarpetas que son proyectos hermanos o carpetas de descargas -->
  <ItemGroup>
    <Compile Remove="version_prueba\**" />
    <EmbeddedResource Remove="version_prueba\**" />
    <None Remove="version_prueba\**" />
    <Page Remove="version_prueba\**" />
    <Compile Remove="webnodo\descargas\**" />
    <EmbeddedResource Remove="webnodo\descargas\**" />
    <None Remove="webnodo\descargas\**" />
    <Compile Remove="webnodo\node_modules\**" />
    <EmbeddedResource Remove="webnodo\node_modules\**" />
    <None Remove="webnodo\node_modules\**" />
    <!-- VisorLinux es un proyecto hermano (Avalonia + net8.0): no forma parte del .exe WPF -->
    <Compile Remove="VisorLinux\**" />
    <EmbeddedResource Remove="VisorLinux\**" />
    <None Remove="VisorLinux\**" />
    <Page Remove="VisorLinux\**" />
    <!-- Tests es un proyecto hermano (xUnit) que referencia a éste: no forma parte del .exe -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <!--
      Nucleo es el proyecto hermano con el código común (red, chat, portal, OTA,
      cuenta). Entra en el .exe por ProjectReference, no por glob: sin esta
      exclusión el default de .NET lo compilaría dos veces.
    -->
    <Compile Remove="Nucleo\**" />
    <EmbeddedResource Remove="Nucleo\**" />
    <None Remove="Nucleo\**" />
    <Page Remove="Nucleo\**" />
  </ItemGroup>

  <!-- Los tests unitarios necesitan ver los puntos de sutura internos (W-01/DT-11) -->
  <ItemGroup>
    <InternalsVisibleTo Include="Visor3DTests" />
  </ItemGroup>

  <!-- Dependencias -->
  <ItemGroup>
    <!-- WMI: lectura de hardware (CPU, placa base, SO) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Chat de voz: captura/reproducción PCM de baja latencia -->
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- Chat de webcam: captura DirectShow y compresión JPEG -->
    <PackageReference Include="AForge.Video" Version="2.2.5" />
    <PackageReference Include="AForge.Video.DirectShow" Version="2.2.5" />
  </ItemGroup>

  <!-- Recursos web (para fases posteriores y WebNodo) -->
  <ItemGroup>
    <None Update="webnodo\public\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="www\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Núcleo común (U3): red, chat, portal, OTA y seguridad de cuenta -->
  <ItemGroup>
    <ProjectReference Include="Nucleo\Nucleo.csproj" />
  </ItemGroup>

  <!-- Recursos embebidos para distribución standalone en un único .exe -->
  <ItemGroup>
    <!-- La lista BIP-39 y los recursos del portal los embebe Nucleo: el código que
         los lee vive allí (GetExecutingAssembly / typeof(…).Assembly). -->
    <!-- Interruptor de desarrollo: -p:SkipGodotAssets=true compila la UI sin el motor ni el mundo.
         La build de distribución NO define la propiedad, así que los incluye. -->
    <EmbeddedResource Include="godot_exe.zip" Condition="'$(SkipGodotAssets)' != 'true'" />
    <EmbeddedResource Include="wvp3d.pck" Condition="'$(SkipGodotAssets)' != 'true'" />
  </ItemGroup>

</Project>