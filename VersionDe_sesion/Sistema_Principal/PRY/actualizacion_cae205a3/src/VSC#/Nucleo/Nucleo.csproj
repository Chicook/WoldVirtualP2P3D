<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo común de los dos visores (U3). Reúne lo que antes enlazaba
    VisorLinux.csproj ficha a ficha: red P2P, chat, portal WebNodo, OTA y
    seguridad de cuenta. Es net8.0 sin UI, así que el mismo IL vale para el
    exe WPF (net8.0-windows) y para el visor Linux (Avalonia, net8.0).
    Los namespaces siguen siendo Visor3D.* para no tocar ni una llamada.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Visor3D</RootNamespace>
    <AssemblyName>WoldVirtualNucleo</AssemblyName>
    <Version>$(WoldVersion)</Version>
    <AssemblyVersion>$(WoldVersion).0</AssemblyVersion>
    <FileVersion>$(WoldVersion).0</FileVersion>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los tests unitarios y el visor necesitan ver los puntos de sutura (W-01/DT-11) -->
    <InternalsVisibleTo Include="Visor3DTests" />
  </ItemGroup>

  <!--
    Recursos que lee código de este ensamblado. Se enlazan desde su sitio de
    siempre para no mover el material de la aplicación: Bip39.cs usa
    GetExecutingAssembly(), así que desde ahora la lista BIP-39 y el HTML del
    portal tienen que estar embebidos AQUÍ, no en cada visor.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Seguridad\bip39-english.txt" LogicalName="Visor3D.Seguridad.bip39-english.txt" />
    <EmbeddedResource Include="..\webnodo\public\index.html" LogicalName="Visor3D.webnodo.public.index.html" />
    <EmbeddedResource Include="..\webnodo\public\metaverso.jpg" LogicalName="Visor3D.webnodo.public.metaverso.jpg" />
  </ItemGroup>

</Project>
