<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>woldvirtual-linux</AssemblyName>
    <RootNamespace>Visor3D.Linux</RootNamespace>
    <Version>$(WoldVersion)</Version>
    <AssemblyVersion>$(WoldVersion).0</AssemblyVersion>
    <FileVersion>$(WoldVersion).0</FileVersion>
    <AssemblyTitle>Wold Virtual P2P 3D — visor Linux</AssemblyTitle>
    <Description>Visor adaptado para Linux v$(WoldVersion) (misma version que el visor Windows, la dicta src/VERSION.json): cuenta local, portal WebNodo con tunel P2P, invitacion, chat de texto, amigos, lanzamiento del motor Godot y comprobacion de actualizaciones. Conserva las correcciones H0-H4 —OTA fail-closed sin SHA-256, endpoint LAN dinamico, preservacion de datos en cierre, WebNodoService invariante y estado de cuenta sincronizado— y suma el portal que lee el release.json real con esquema {assets[]} y la autoprueba del nodo.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <!--
    Núcleo común con el visor WPF (U3): ya no se enlaza ficha a ficha. El mismo
    ensamblado (Nucleo/Nucleo.csproj, net8.0 sin UI) vale para los dos visores,
    así que no hay IL duplicado ni lista que mantener sincronizada. Lo que sigue
    propio de cada plataforma es la UI (Vistas/*) y Linux/*: InstanciaUnica,
    RegistroPcUnico, ReinicioCuenta, RuntimeLinux y ActualizadorLinux.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nucleo\Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BIP-39 y los recursos del portal los embebe Nucleo (U3). Aquí sólo van
         los específicos de Linux: el motor y el mundo.
         -p:SkipGodotAssets=true compila la UI sola (sin motor ni mundo). -->
    <EmbeddedResource Include="../godot_linux.zip" LogicalName="Visor3D.Linux.godot_linux.zip"
                      Condition="'$(SkipGodotAssets)' != 'true'" />
    <EmbeddedResource Include="../wvp3d.pck" LogicalName="Visor3D.Linux.wvp3d.pck"
                      Condition="'$(SkipGodotAssets)' != 'true'" />
  </ItemGroup>

</Project>
