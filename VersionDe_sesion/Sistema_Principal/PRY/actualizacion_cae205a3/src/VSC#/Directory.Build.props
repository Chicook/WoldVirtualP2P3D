<Project>

  <!--
    Version unica del producto: src/VERSION.json (una carpeta por encima de VSC#/).

    Por que aqui: hasta U5 el numero vivia en cuatro sitios que se desmentian (Visor3D.csproj,
    VisorLinux.csproj, RutasLinux.cs y el AssemblyInfo generado en obj/). La medida esta en el plan
    §1.6: el binario publicado como 2.7.6 salia de un arbol que declaraba 2.7.5.

    Sin respaldo silencioso: si VERSION.json no esta o no es x.y.z, el build para. Un valor por
    defecto volveria a producir el desfase binario/anuncio que se cerro en DT-08.
    La generacion del C# constante vive en Directory.Build.targets: IntermediateOutputPath aun no
    existe cuando se evalua este fichero.
  -->

  <PropertyGroup>
    <WoldVersionJsonPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\VERSION.json'))</WoldVersionJsonPath>
    <WoldVersionJsonText Condition="Exists('$(WoldVersionJsonPath)')">$([System.IO.File]::ReadAllText($(WoldVersionJsonPath)))</WoldVersionJsonText>
    <WoldVersion>$([System.Text.RegularExpressions.Regex]::Match($(WoldVersionJsonText), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</WoldVersion>
    <WoldMotor>$([System.Text.RegularExpressions.Regex]::Match($(WoldVersionJsonText), '&quot;motor&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</WoldMotor>
    <WoldPckSha256>$([System.Text.RegularExpressions.Regex]::Match($(WoldVersionJsonText), '&quot;pck_sha256&quot;\s*:\s*&quot;([0-9a-f]+)&quot;').Groups[1].Value)</WoldPckSha256>
    <WoldFecha>$([System.Text.RegularExpressions.Regex]::Match($(WoldVersionJsonText), '&quot;fecha&quot;\s*:\s*&quot;([0-9-]+)&quot;').Groups[1].Value)</WoldFecha>
  </PropertyGroup>

  <Target Name="WoldComprobarVersionUnica" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(WoldVersionJsonPath)')"
           Text="VERSION.json no existe en $(WoldVersionJsonPath). Es la unica fuente del numero: crealo o corrige la ruta en VSC#/Directory.Build.props." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(WoldVersion)', '^\d+\.\d+\.\d+$'))"
           Text="VERSION.json no declara una version x.y.z valida (leido: '$(WoldVersion)')." />
    <Error Condition="'$(WoldMotor)' == ''"
           Text="VERSION.json no declara el campo «motor»." />
  </Target>

</Project>
