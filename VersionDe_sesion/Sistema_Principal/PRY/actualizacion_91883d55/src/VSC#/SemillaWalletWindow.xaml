<Window x:Class="Visor3D.SemillaWalletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D — Wallet DeFi Frase Semilla"
        Width="640" Height="610"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C12"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanMinimize">

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Título -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- Cartel de advertencia -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- Cuadrícula 12 palabras -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- Hash de la semilla -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Botón Descargar Zip -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Botón Continuar -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- Mensaje de estado -->
        </Grid.RowDefinitions>

        <!-- ── Título ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Wallet DeFi — Frase Semilla"
                       Foreground="#00D9FF"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Paso 3 de 5 — Clave de recuperación maestra de tu wallet interna"
                       Foreground="#8892B0"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Cartel de Advertencia Destacado ── -->
        <Border Grid.Row="2"
                Background="#1B1204"
                BorderBrush="#D97706"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="⚠️  GUARDA LA FRASE SEMILLA EN UN LUGAR SEGURO"
                               Foreground="#FBBF24"
                               FontSize="12"
                               FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Estas 12 palabras son la clave maestra de tu wallet de criptomonedas DeFi embebida en el metaverso. Si las pierdes, nadie podrá recuperar tus fondos ni tu identidad descentralizada."
                           Foreground="#E5E7EB"
                           FontSize="10.5"
                           LineHeight="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Contenedor de las 12 Palabras Semilla ── -->
        <Border Grid.Row="4"
                Background="#0F1420"
                BorderBrush="#1D3557"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <UniformGrid x:Name="GridPalabras" Columns="3" Rows="4">
                <!-- Se poblará dinámicamente desde C# con las 12 palabras numeradas -->
            </UniformGrid>
        </Border>

        <!-- ── Hash Único de la Semilla ── -->
        <Border Grid.Row="6"
                Background="#091220"
                BorderBrush="#163B67"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Hash Semilla:"
                           Foreground="#8892B0"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHashSemilla"
                           Grid.Column="1"
                           Text="Generando..."
                           Foreground="#00D9FF"
                           FontSize="10"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ── Botón Descargar Semilla (.zip) ── -->
        <Button x:Name="BtnDescargarSemilla"
                Grid.Row="8"
                Content="⬇  Descargar frase semilla (.zip)"
                Height="40"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#FFFFFF"
                Background="#0077B6"
                BorderBrush="#0096C7"
                BorderThickness="1"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- ── Botón Continuar a Verificación ── -->
        <Button x:Name="BtnContinuar"
                Grid.Row="10"
                Content="Continuar a la verificación  →"
                Height="38"
                FontSize="13"
                FontWeight="Bold"
                Foreground="#4A5568"
                Background="#161B26"
                BorderBrush="#2D3748"
                BorderThickness="1"
                IsEnabled="False"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- ── Mensaje de estado al fondo ── -->
        <TextBlock x:Name="TxtEstado"
                   Grid.Row="12"
                   Text="✔ Frase semilla descargada correctamente — ya puedes continuar"
                   Foreground="#22C55E"
                   FontSize="11"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
