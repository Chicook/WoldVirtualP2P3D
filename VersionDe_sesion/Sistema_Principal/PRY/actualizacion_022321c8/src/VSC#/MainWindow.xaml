<Window x:Class="Visor3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wold Virtual p2p 3D"
        Width="1120" Height="630"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10"
        Topmost="False"
        WindowStyle="ThreeDBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Estilo con placeholder para TxtUrlAmigo -->
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <TextBlock x:Name="Placeholder"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#3A5A78"
                                           FontStyle="Italic"
                                           FontSize="10"
                                           Padding="5,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Área 3D central / Área de bienvenida -->
            <RowDefinition Height="*"/>
            <!-- Barra inferior (oculta en pantalla de bienvenida) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 1. PANTALLA DE BIENVENIDA (Inicial)                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelBienvenida" Grid.Row="1" Background="#0A0C12">
            <!-- Efecto de gradiente radial de fondo sutil -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#0F1420"
                    BorderBrush="#1D3557"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="48,40"
                    MaxWidth="520">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <!-- Título del metaverso -->
                    <TextBlock Text="WOLD VIRTUAL P2P 3D"
                               Foreground="#00D9FF"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Bienvenido a el metaverso p2p descentralizado"
                               Foreground="#8892B0"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Estado de la red P2P antes de entrar: vacío u ocupado -->
                    <Border x:Name="BordeEstadoRed"
                            Background="#0A1524"
                            BorderBrush="#1D3A5C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock x:Name="TxtEstadoRed"
                                       Text="Buscando nodos en tu red…"
                                       Foreground="#7ECFFF"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtDetalleRed"
                                       Text="Si no hay nadie, entrarás como primero de la sesión."
                                       Foreground="#8892B0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnBuscarRed"
                                        Content="Buscar de nuevo"
                                        Width="130" Height="24"
                                        FontSize="10.5"
                                        Foreground="#8892B0"
                                        Background="#101A2A"
                                        BorderBrush="#1D3A5C"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                                <Button x:Name="BtnUsarNodoRed"
                                        Content="Usar este nodo"
                                        Width="122" Height="24"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="#00D9FF"
                                        Background="#0A1E30"
                                        BorderBrush="#00D9FF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        Margin="8,0,0,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Botón Crear Cuenta -->
                    <Button x:Name="BtnCrearCuenta"
                            Content="Crear Cuenta"
                            Width="260" Height="42"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#FFFFFF"
                            Background="#0077B6"
                            BorderBrush="#0096C7"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="0,0,0,14">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Botón Acceder -->
                    <Button x:Name="BtnAcceder"
                            Content="Acceder"
                            Width="260" Height="42"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#E2E8F0"
                            Background="#162238"
                            BorderBrush="#2A4365"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 2. VISTA DEL MUNDO 3D (Se muestra tras acceder)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="PanelMundo3D" Grid.Row="1" Visibility="Collapsed" Background="#050811">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>  <!-- Barra superior de sesión -->
                <RowDefinition Height="*"/>   <!-- Viewport / HUD 3D -->
            </Grid.RowDefinitions>

            <!-- Barra superior de sesión autenticada (zona WPF pura: aquí vive todo lo flotante) -->
            <Grid Grid.Row="0">
            <Border Background="#0A0F1D" BorderBrush="#163B67" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: nombre y estado -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐 WOLD VIRTUAL P2P" Foreground="#00D9FF" FontSize="13" FontWeight="Bold" Margin="0,0,12,0"/>
                        <Border Background="#162238" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtSesionUsuario" Text="Usuario: ---" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="BordeEstadoP2P" Background="#1A2A1A" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtEstadoP2P" Text="⏳ Red P2P: iniciando..." Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Centro: enlace P2P propio + WebNodo -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="BannerP2P" Visibility="Collapsed"
                                Background="#0D2137" BorderBrush="#00D9FF" BorderThickness="1"
                                CornerRadius="4" Padding="10,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtEtiquetaEnlace" Text="🔗 Tu enlace P2P: " Foreground="#8892B0" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtUrlP2P" Text="" Foreground="#00D9FF" FontSize="10.5" FontFamily="Consolas"
                                           FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                           MaxWidth="420" TextTrimming="CharacterEllipsis"
                                           ToolTip="Haz clic para copiar y comparte este enlace por WhatsApp con un amigo"/>
                                <TextBlock Text=" " Width="6"/>
                                <Button x:Name="BtnCopiarUrlP2P"
                                        Content="📋 Copiar"
                                        Height="20" Padding="6,1"
                                        FontSize="10" FontWeight="SemiBold"
                                        Foreground="#00D9FF" Background="#0F2744"
                                        BorderBrush="#00D9FF" BorderThickness="1"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- WebNodo: portal de descarga del visor para amigos -->
                        <Button x:Name="BtnWebNodo"
                                Content="🌐 WebNodo"
                                Height="24" Padding="8,1"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#00D9FF" Background="#0F2744"
                                BorderBrush="#00D9FF" BorderThickness="1"
                                Cursor="Hand"
                                Margin="10,0,0,0"
                                ToolTip="Abre el portal de descarga del visor (WebNodo) para compartirlo con tus amigos">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Solo aparece si el proceso de Godot muere: reincrustar sin cerrar el visor -->
                        <Button x:Name="BtnReiniciar3D"
                                Content="⟳ Reiniciar 3D"
                                Height="24" Padding="8,1"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#FCD34D" Background="#2A2110"
                                BorderBrush="#B45309" BorderThickness="1"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                ToolTip="El motor 3D se detuvo. Pulsa para volver a incrustarlo sin cerrar el visor.">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Diagnóstico: copia versión, estado y log al portapapeles -->
                        <Button x:Name="BtnDiagnostico"
                                Content="ⓘ"
                                Width="24" Height="24" Padding="0"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#94A3B8" Background="Transparent"
                                BorderBrush="#1D3A5C" BorderThickness="1"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                ToolTip="Copiar diagnóstico (versión, estado y últimas líneas del log)">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Derecha: actualización, llave y cerrar sesión -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Actualización: dentro de la barra (zona WPF), justo antes de la llave -->
                        <Button x:Name="BtnActualizar"
                                Height="26" MinWidth="108" Padding="9,0" Margin="0,0,10,0"
                                VerticalAlignment="Center" Cursor="Hand"
                                Background="#0F2744" BorderBrush="#1D3A5C" BorderThickness="1"
                                Foreground="#7ECFFF" FontSize="10" FontWeight="SemiBold"
                                ToolTipService.ShowDuration="20000"
                                ToolTip="Buscando actualizaciones…"
                                AutomationProperties.Name="Actualizar el visor"
                                Click="OnActualizarClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Marco" CornerRadius="13"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="#00D9FF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Marco" Property="Background" Value="#0B2A46"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Marco" Property="Opacity" Value="0.65"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BtnActualizarVisual" Width="16" Height="16" Background="Transparent">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="GlowActualizar" Color="#38BDF8"
                                                          BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Path x:Name="IconoDescarga" Data="M12,2V13M12,13L7,8M12,13L17,8M5,18H19"
                                              Stroke="#38BDF8" StrokeThickness="2" Stretch="Uniform" Margin="1"/>
                                        <Path x:Name="IconoAlDia" Data="M4,12L9,17L20,6"
                                              Stroke="#22C55E" StrokeThickness="2" Stretch="Uniform" Margin="1"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TxtEtiquetaActualizar" Text="Buscando…"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtProgresoPorcentaje" Text="0 %"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="10" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TxtSesionLlave" Text="Llave: ---" Foreground="#8892B0" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnCerrarSesion"
                                Content="Cerrar Sesión"
                                Width="95" Height="26"
                                FontSize="11"
                                Foreground="#F87171"
                                Background="#2A1215"
                                BorderBrush="#7F1D1D"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

                <!-- Progreso de descarga: 2 px en el borde inferior de la barra (nunca sobre el HwndHost) -->
                <Grid x:Name="BarProgreso" Height="2" VerticalAlignment="Bottom"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColProgreso" Width="0*"/>
                        <ColumnDefinition x:Name="ColResto" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#38BDF8"/>
                    <Border Grid.Column="1" Background="#163B67"/>
                </Grid>
            </Grid>

            <!-- Área Central 3D -->
            <Grid Grid.Row="1">
                <!-- Contenedor del HwndHost de Godot. OJO: es un HWND nativo y se pinta
                     SIEMPRE por encima del resto de WPF de esta región (airspace). Por eso
                     aquí no se pone ningún control: la UI vive en la barra superior. -->
                <Grid x:Name="ContenedorGodotMain" Background="#000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 3. BARRA INFERIOR DE LOGIN (Solo visible al elegir Acceder) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="BarraInferiorLogin" Grid.Row="2"
                Height="40"
                Background="#0D1117"
                BorderBrush="#163B67"
                BorderThickness="0,1.5,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Botón Volver -->
                <Button x:Name="BtnVolverBienvenida"
                        Content="← Volver"
                        Width="75" Height="24"
                        FontSize="11"
                        Foreground="#8892B0"
                        Background="#161B26"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,16,0"/>

                <!-- Label Usuario -->
                <TextBlock Text="Usuario:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Usuario -->
                <TextBox x:Name="TxtLoginUser"
                         Width="130" Height="24"
                         FontSize="12"
                         Padding="4,2"
                         Background="#161B26"
                         Foreground="#E2E2E2"
                         BorderBrush="#163B67"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Label Contraseña -->
                <TextBlock Text="Contraseña:"
                           Foreground="#9AA0B2"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <!-- Campo Contraseña -->
                <PasswordBox x:Name="TxtLoginPass"
                             Width="130" Height="24"
                             FontSize="12"
                             Padding="4,2"
                             Background="#161B26"
                             Foreground="#E2E2E2"
                             BorderBrush="#163B67"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"/>

                <TextBlock Width="14"/>

                <!-- Botón Iniciar Sesión -->
                <Button x:Name="BtnLogin"
                        Content="Iniciar Sesión"
                        Width="105" Height="28"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Background="#0F3460"
                        BorderBrush="#163B67"
                        BorderThickness="1"
                        Cursor="Hand"
                        Panel.ZIndex="1"
                        Margin="0,0,18,0"/>

                <!-- Separador visual -->
                <Border Width="1" Height="22" Background="#163B67" Margin="0,0,14,0"/>

                <!-- Campo URL de amigo -->
                <TextBlock Text="Web amigo:"
                           Foreground="#64748B"
                           FontSize="11"
                           FontStyle="Italic"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBox x:Name="TxtUrlAmigo"
                         Width="250" Height="24"
                         FontSize="10.5"
                         Padding="4,2"
                         Background="#0D1520"
                         Foreground="#7ECFFF"
                         BorderBrush="#1D3A5C"
                         BorderThickness="1"
                         CaretBrush="#00D9FF"
                         VerticalContentAlignment="Center"
                         FontFamily="Consolas"
                         Style="{StaticResource PlaceholderTextBoxStyle}"
                         ToolTip="Pega aquí el enlace P2P que te compartió un amigo. Si no tienes, inicia sesión directamente."
                         Tag="(llellenalo si tienes web de un amigo, si no inicia sesion)"/>
                <Button x:Name="BtnConectarAmigo"
                        Content="🔗 Conectar"
                        Width="80" Height="24"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="#00D9FF"
                        Background="#0A1E30"
                        BorderBrush="#00D9FF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="4,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
