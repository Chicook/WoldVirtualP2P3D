# Normalización de fin de línea automática
* text=auto eol=lf

# Scripts y ejecutables
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Código fuente y configuraciones
*.cs text diff=csharp
*.gd text
*.tscn text
*.tres text
*.godot text
*.json text
*.xml text
*.xaml text
*.py text diff=python
*.md text
*.txt text

# Binarios de Godot y 3D
*.blend binary
*.gltf text
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.dll binary
*.exe binary
*.ico binary
