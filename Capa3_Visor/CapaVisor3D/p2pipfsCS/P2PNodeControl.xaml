<UserControl x:Class="VisorSingularity.p2pipfsCS.P2PNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisorSingularity.p2pipfsCS"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="360">
    <UserControl.Resources>
        <!-- Estilos Cyberpunk -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Button" x:Key="CyberpunkButton">
            <Setter Property="Background" Value="#45A29E"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#66FCF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FCF1"/>
                    <Setter Property="BorderBrush" Value="#45A29E"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                    <Setter Property="Foreground" Value="#66FCF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Border CornerRadius="8" BorderThickness="1.5" Background="#CC222222" BorderBrush="#45A29E">
        <Border.Effect>
            <DropShadowEffect Color="#66FCF1" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Título del Panel -->
            <TextBlock Text="NODO P2P/IPFS" Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#66FCF1" BlurRadius="5" ShadowDepth="0" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Estado del Nodo -->
            <TextBlock Text="Estado:" Grid.Row="1" Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="NodeStatus" Text="Desconectado" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF5555"/>

            <!-- Identificador del Nodo -->
            <TextBlock Text="ID:" Grid.Row="2" Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,5,0"/>
            <TextBlock x:Name="NodeIdText" Text="NDXXXXX" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,5,0,0" Foreground="#C5C6C7"/>

            <!-- Paquetes/Peers -->
            <TextBlock Text="Peers:" Grid.Row="3" Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,5,0"/>
            <TextBlock x:Name="PeerCount" Text="0" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,5,0,0" Foreground="#C5C6C7"/>

            <!-- URL/IPFS Hash -->
            <TextBlock Text="URL:" Grid.Row="4" Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,5,0"/>
            <TextBlock x:Name="NodeUrl" Text="www.NDXXXXX.woldvirtual" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,5,0,0" Foreground="#C5C6C7" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>