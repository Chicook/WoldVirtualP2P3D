<UserControl x:Class="VisorSingularity.ServidorDescentralizado.DecentralizedServerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisorSingularity.ServidorDescentralizado"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="400">
    <UserControl.Resources>
        <!-- Estilos Cyberpunk -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#66FCF1" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="CyberpunkButton">
            <Setter Property="Background" Value="#45A29E"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#66FCF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FCF1"/>
                    <Setter Property="BorderBrush" Value="#45A29E"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                    <Setter Property="Foreground" Value="#66FCF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="CyberpunkToggleButton">
            <Setter Property="Background" Value="#45A29E"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#66FCF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FCF1"/>
                    <Setter Property="BorderBrush" Value="#45A29E"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#00ff8c"/>
                    <Setter Property="BorderBrush" Value="#00ff8c"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                    <Setter Property="Foreground" Value="#66FCF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Título y Estado -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="&#x26A1;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock Text="Servidor Descentralizado" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusIndicator" Text="● Inactivo" Margin="10,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Controles de Monitoreo -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ProgressBar x:Name="CpuBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="CpuLabel" Text="0%" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="RAM:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ProgressBar x:Name="RamBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="RamLabel" Text="0/256 MB" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Botones de Control -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ToggleButton x:Name="ToggleMonitoring" Content="Activar" Style="{StaticResource CyberpunkToggleButton}" Checked="ToggleMonitoring_Checked" Unchecked="ToggleMonitoring_Unchecked"/>
            <Button Content="Configurar" Style="{StaticResource CyberpunkButton}" Margin="10,0,0,0" Click="SettingsButton_Click"/>
            <Button Content="Minar" Style="{StaticResource CyberpunkButton}" Margin="10,0,0,0" Click="MiningRigButton_Click"/>
            <Button Content="Compartir IPFS" Style="{StaticResource CyberpunkButton}" Margin="10,0,0,0" Click="IpfsShareButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>