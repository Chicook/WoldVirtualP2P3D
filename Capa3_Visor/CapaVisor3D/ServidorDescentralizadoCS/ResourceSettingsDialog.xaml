<Window x:Class="VisorSingularity.ServidorDescentralizado.ResourceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configurar límites de recursos" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0B0C10"
        BorderBrush="#45A29E" BorderThickness="1"
        Foreground="#66FCF1">
    <Window.Resources>
        <!-- Estilos Cyberpunk -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#45A29E"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="Background" Value="#1F2833"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Height="4" Grid.Row="1"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Background="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <Thumb.Effect>
                                            <DropShadowEffect Color="#66FCF1" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                                        </Thumb.Effect>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="CyberpunkButton">
            <Setter Property="Background" Value="#45A29E"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#66FCF1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FCF1"/>
                    <Setter Property="BorderBrush" Value="#45A29E"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                    <Setter Property="Foreground" Value="#66FCF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configurar límites de recursos" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- CPU -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <Label Content="CPU (%):"/>
            <Slider x:Name="CpuSlider" Minimum="0" Maximum="100" Value="10"/>
            <TextBlock x:Name="CpuValue" Text="{Binding ElementName=CpuSlider, Path=Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- RAM -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <Label Content="RAM (MB):"/>
            <Slider x:Name="RamSlider" Minimum="0" Maximum="1024" Value="256"/>
            <TextBlock x:Name="RamValue" Text="{Binding ElementName=RamSlider, Path=Value, StringFormat={}{0:F0} MB}" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Disco Duro -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <Label Content="Disco Duro (MB):"/>
            <Slider x:Name="DiskSlider" Minimum="0" Maximum="2048" Value="500"/>
            <TextBlock x:Name="DiskValue" Text="{Binding ElementName=DiskSlider, Path=Value, StringFormat={}{0:F0} MB}" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- VRAM -->
        <StackPanel Grid.Row="4" Margin="0,5">
            <Label Content="VRAM (MB):"/>
            <Slider x:Name="VramSlider" Minimum="0" Maximum="1024" Value="128"/>
            <TextBlock x:Name="VramValue" Text="{Binding ElementName=VramSlider, Path=Value, StringFormat={}{0:F0} MB}" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Ancho de Banda -->
        <StackPanel Grid.Row="5" Margin="0,5">
            <Label Content="Ancho de Banda (Mbps):"/>
            <Slider x:Name="BandwidthSlider" Minimum="0" Maximum="100" Value="10"/>
            <TextBlock x:Name="BandwidthValue" Text="{Binding ElementName=BandwidthSlider, Path=Value, StringFormat={}{0:F0} Mbps}" HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar" Style="{StaticResource CyberpunkButton}" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Cancelar" Style="{StaticResource CyberpunkButton}" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>