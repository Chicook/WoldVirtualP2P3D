<Application x:Class="VisorSingularity.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Singularity Cyberpunk/Metaverse Theme -->
        
        <!-- Base Window Style -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="#0B0C10"/>
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Labels -->
        <Style x:Key="SingularityLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- TextBoxes -->
        <Style x:Key="SingularityTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2833"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#66FCF1"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PasswordBox (Custom style since it doesn't support direct Styling easily without control template, but we can do basic properties) -->
        <Style x:Key="SingularityPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1F2833"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#66FCF1"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBoxes -->
        <Style x:Key="SingularityCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#66FCF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons (Sleek Glassmorphism/Neon look) -->
        <Style x:Key="SingularityButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2833"/>
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45A29E"/>
                    <Setter Property="Foreground" Value="#0B0C10"/>
                    <Setter Property="BorderBrush" Value="#66FCF1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#66FCF1"/>
                    <Setter Property="Foreground" Value="#0B0C10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Menu -->
        <Style x:Key="SingularityMenu" TargetType="Menu">
            <Setter Property="Background" Value="#1F2833"/>
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- MenuItem -->
        <Style x:Key="SingularityMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#66FCF1"/>
                    <Setter Property="Background" Value="#0B0C10"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
