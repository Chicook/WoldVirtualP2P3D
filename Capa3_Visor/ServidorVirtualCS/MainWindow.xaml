<Window x:Class="ServidorVirtualCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ServidorVirtualCS.Controls"
        mc:Ignorable="d"
        Title="ServidorVirtualCS"
        Width="1280"
        Height="720"
        Background="#101B27"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#152230" BorderBrush="#20384D" BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        CornerRadius="6"
                        BorderBrush="#28455E"
                        BorderThickness="1"
                        Background="#122131"/>

                <Border Grid.Column="1"
                        Margin="0"
                        Padding="8"
                        CornerRadius="2"
                        BorderBrush="#FF8C3A"
                        BorderThickness="2"
                        Background="#152230">
                    <controls:EmbeddedNodeControl />
                </Border>

                <Border Grid.Column="2"
                        Margin="12,0,0,0"
                        CornerRadius="6"
                        BorderBrush="#28455E"
                        BorderThickness="1"
                        Background="#122131"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Margin="0" Background="#2EA6C9"/>
            <TextBlock Text="AREA 3D / HOST DEL VISOR"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#D7F6FF"
                       FontSize="28"
                       FontWeight="Bold"
                       Opacity="0.6"/>
        </Grid>

        <Border Grid.Row="2" Background="#152230" BorderBrush="#20384D" BorderThickness="0,1,0,0">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="IPFS NODE"
                           VerticalAlignment="Center"
                           Foreground="#66FCF1"
                           FontWeight="Bold"/>

                <TextBlock Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="#A5C4D4"
                           Text="El panel superior queda listo para incrustarse en el recuadro del visor."/>

                <Button Grid.Column="2"
                        Width="132"
                        Padding="10,4"
                        Content="REFRESCAR NODO"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
