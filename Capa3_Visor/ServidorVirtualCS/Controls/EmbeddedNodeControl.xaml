<UserControl x:Class="ServidorVirtualCS.Controls.EmbeddedNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="58"
             d:DesignWidth="404">
    <UserControl.Resources>
        <Style x:Key="HudSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#1E88E5" Stroke="#BFE4FF" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#7F8C8D"/>
            <Setter Property="Foreground" Value="#1E88E5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,2">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Focusable="False"
                                                  Background="{TemplateBinding Foreground}"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource HudSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Focusable="False"
                                                  Background="{TemplateBinding Background}"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="4"
            Padding="5,4"
            Background="#CC0D1C29"
            BorderBrush="#1F8BD1"
            BorderThickness="1">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 0: Dot -->
                    <ColumnDefinition Width="6"/>    <!-- 1: Spacing -->
                    <ColumnDefinition Width="Auto"/> <!-- 2: Avatar/Photo -->
                    <ColumnDefinition Width="8"/>    <!-- 3: Spacing -->
                    <ColumnDefinition Width="Auto"/> <!-- 4: Node info -->
                    <ColumnDefinition Width="8"/>    <!-- 5: Spacing -->
                    <ColumnDefinition Width="*"/>    <!-- 6: Status Text -->
                    <ColumnDefinition Width="8"/>    <!-- 7: Spacing -->
                    <ColumnDefinition Width="Auto"/> <!-- 8: CID -->
                    <ColumnDefinition Width="6"/>    <!-- 9: Spacing -->
                    <ColumnDefinition Width="Auto"/> <!-- 10: IPFS button -->
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                          Width="10"
                          Height="10"
                          VerticalAlignment="Center"
                          Fill="{Binding ActivityBrush}"/>

                <!-- 2: Avatar/Photo (Dynamic vector cyberpunk icon based on UserGender) -->
                <Border Grid.Column="2" 
                        Width="24" 
                        Height="24" 
                        CornerRadius="12" 
                        BorderThickness="1.5" 
                        VerticalAlignment="Center"
                        Background="#0F172A">
                    <Grid>
                        <!-- MALE AVATAR -->
                        <Path x:Name="MaleIcon" 
                              Data="M12,4A4,4,0,1,0,16,8,4,4,0,0,0,12,4Zm0,6A2,2,0,1,1,14,8,2,2,0,0,1,12,10Zm0,3c-4.42,0-8,2-8,4.5V19H20V17.5C20,15,16.42,13,12,13Zm-6.19,4c.66-.86,2.78-1.5,6.19-1.5s5.53.64,6.19,1.5Z" 
                              Fill="#00E5FF" 
                              Width="14" 
                              Height="14" 
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserGender}" Value="male">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                              
                        <!-- FEMALE AVATAR -->
                        <Path x:Name="FemaleIcon" 
                              Data="M12,4A4,4,0,1,0,16,8,4,4,0,0,0,12,4Zm0,6A2,2,0,1,1,14,8,2,2,0,0,1,12,10Zm0,3c-4.42,0-8,2-8,4.5V19H20V17.5C20,15,16.42,13,12,13Zm-6.19,4c.66-.86,2.78-1.5,6.19-1.5s5.53.64,6.19,1.5Z" 
                              Fill="#FF007F" 
                              Width="14" 
                              Height="14" 
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserGender}" Value="female">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <!-- GENERIC / UNKNOWN AVATAR (Futuristic Node) -->
                        <Path x:Name="GenericIcon" 
                              Data="M12,2L2,7L12,12L22,7L12,2M2,17L12,22L22,17M2,12L12,17L22,12" 
                              Fill="#FF8C3A" 
                              Width="14" 
                              Height="14" 
                              Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserGender}" Value="male">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UserGender}" Value="female">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        
                        <!-- AVATAR PHOTO -->
                        <Ellipse Width="24" Height="24">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImageSource}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#FF8C3A"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.6" Color="#FF8C3A"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UserGender}" Value="male">
                                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#00E5FF"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UserGender}" Value="female">
                                    <Setter Property="BorderBrush" Value="#FF007F"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#FF007F"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="SERVIDOR DESCENTRALIZADO"
                               Foreground="#66FCF1"
                               FontSize="9"
                               FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ActivityText}"
                                   Foreground="{Binding ActivityBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                        <TextBlock Text="  "
                                   FontSize="9"/>
                        <TextBlock Text="{Binding NodeName}"
                                   Foreground="White"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="6"
                           VerticalAlignment="Center"
                           Foreground="#C6D8E2"
                           FontSize="9"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText}"/>

                <StackPanel Grid.Column="8" VerticalAlignment="Center">
                    <TextBlock Text="CID"
                               Foreground="#7CB0C6"
                               FontSize="9"/>
                    <TextBlock Text="{Binding PublishedCid}"
                               Width="78"
                               Foreground="#66FCF1"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="10"
                        Width="54"
                        Height="20"
                        Padding="4,1"
                        VerticalAlignment="Center"
                        FontSize="9"
                        Content="IPFS"
                        Command="{Binding PublishCommand}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,4,0" Padding="4,1" Background="#173246" CornerRadius="3">
                    <TextBlock Foreground="White" FontSize="8.5" Text="{Binding CpuBudget, StringFormat=CPU {0}M}"/>
                </Border>

                <Border Grid.Column="1" Margin="0,0,4,0" Padding="4,1" Background="#173246" CornerRadius="3">
                    <TextBlock Foreground="White" FontSize="8.5" Text="{Binding RamBudget, StringFormat=RAM {0}M}"/>
                </Border>

                <Border Grid.Column="2" Margin="0,0,4,0" Padding="4,1" Background="#173246" CornerRadius="3">
                    <TextBlock Foreground="White" FontSize="8.5" Text="{Binding VramBudget, StringFormat=VRAM {0}M}"/>
                </Border>

                <Border Grid.Column="3" Margin="0,0,4,0" Padding="4,1" Background="#173246" CornerRadius="3">
                    <TextBlock Foreground="White" FontSize="8.5" Text="{Binding StorageBudget, StringFormat=DISCO {0}M}"/>
                </Border>

                <Border Grid.Column="4" Margin="0,0,4,0" Padding="4,1" Background="#173246" CornerRadius="3">
                    <TextBlock Foreground="White" FontSize="8.5" Text="{Binding BandwidthBudget, StringFormat=RED {0}M}"/>
                </Border>

                <TextBlock Grid.Column="6"
                           VerticalAlignment="Center"
                           Foreground="#7CB0C6"
                           FontSize="8.5"
                           Text="{Binding TotalBudgetText, StringFormat=TOTAL {0}}"/>

                <TextBlock Grid.Column="7"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#7CB0C6"
                           FontSize="8"
                           Text="MENOS"/>

                <Slider x:Name="BoostSlider"
                        Grid.Column="7"
                        Margin="42,0,30,0"
                        Style="{StaticResource HudSliderStyle}"
                        Minimum="100"
                        Maximum="180"
                        SmallChange="5"
                        LargeChange="10"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="BoostSlider_PreviewMouseLeftButtonDown"
                        ValueChanged="BoostSlider_ValueChanged"
                        Value="{Binding BoostPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="7"
                           HorizontalAlignment="Right"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Foreground="#7CB0C6"
                           FontSize="8"
                           Text="MAS"/>

                <TextBlock Grid.Column="8"
                           VerticalAlignment="Center"
                           Foreground="#19C37D"
                           FontSize="8.5"
                           FontWeight="Bold"
                           Text="{Binding BoostLabel}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
