<UserControl x:Class="VisorSingularity.ServidorDescentralizado.DecentralizedServerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisorSingularity.ServidorDescentralizado"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="400">
    
    <UserControl.Resources>
        <Style x:Key="ResourceBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="Background" Value="#1A2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
        </Style>
        
        <Style x:Key="ResourceLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        
        <Style x:Key="LimitLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#45A29E"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5,5,5,2"/>
        </Style>
    </UserControl.Resources>
    
    <Border Background="#0A1520" BorderBrush="#45A29E" BorderThickness="1" CornerRadius="6">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="🖥️ " Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock Text="Servidor Descentralizado" Style="{StaticResource HeaderTextStyle}"/>
                <TextBlock x:Name="StatusIndicator" Text="●" Foreground="#00FF8C" 
                          FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- CPU -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="CPU:" Style="{StaticResource ResourceLabelStyle}"/>
                <ProgressBar Grid.Column="1" x:Name="CpuBar" Style="{StaticResource ResourceBarStyle}"
                            Minimum="0" Maximum="100" Value="0"/>
                <TextBlock Grid.Column="2" x:Name="CpuLabel" Text="0%" Style="{StaticResource LimitLabelStyle}"/>
            </Grid>
            
            <!-- RAM -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="RAM:" Style="{StaticResource ResourceLabelStyle}"/>
                <ProgressBar Grid.Column="1" x:Name="RamBar" Style="{StaticResource ResourceBarStyle}"
                            Minimum="0" Maximum="100" Value="0"/>
                <TextBlock Grid.Column="2" x:Name="RamLabel" Text="0/256 MB" Style="{StaticResource LimitLabelStyle}"/>
            </Grid>
            
            <!-- Controles -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <ToggleButton x:Name="ToggleMonitoring" Content="Activar" Style="{StaticResource ToggleButtonStyle}"
                             Checked="ToggleMonitoring_Checked" Unchecked="ToggleMonitoring_Unchecked"/>
                <Button x:Name="SettingsButton" Content="⚙️" Width="30" Height="24" Margin="5,2"
                       Click="SettingsButton_Click" ToolTip="Configurar límites"/>
                <Button x:Name="MiningRigButton" Content="⛏️" Width="30" Height="24" Margin="5,2"
                       Click="MiningRigButton_Click" ToolTip="Vincular rig de minería"/>
                <Button x:Name="IpfsShareButton" Content="🌐" Width="30" Height="24" Margin="5,2"
                       Click="IpfsShareButton_Click" ToolTip="Compartir vía IPFS"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>