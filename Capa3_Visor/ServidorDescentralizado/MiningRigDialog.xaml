<Window x:Class="VisorSingularity.ServidorDescentralizado.MiningRigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisorSingularity.ServidorDescentralizado"
        mc:Ignorable="d"
        Title="Vincular Rig de Minería" 
        Height="350" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FCF1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,5,5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#1A2A3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#45A29E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C5C6C7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid Background="#0A1520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Título -->
        <Border Grid.Row="0" Background="#1A2A3A" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⛏️ " FontSize="16" Foreground="#66FCF1"/>
                <TextBlock Text="Vincular Rig de Minería" 
                          Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>
        
        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel>
                <!-- Información -->
                <Border Background="#1A2A3A" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <TextBlock Text="Vincula un rig de minería externo para aumentar la capacidad de procesamiento de la red descentralizada."
                              Foreground="#C5C6C7" TextWrapping="Wrap"/>
                </Border>
                
                <!-- Dirección IP/Host -->
                <TextBlock Text="Dirección del Rig" Style="{StaticResource HeaderStyle}"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="IP/Host:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1" x:Name="RigAddressTextBox" Style="{StaticResource TextBoxStyle}"
                            Text="192.168.1.100"/>
                </Grid>
                
                <!-- Puerto -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Puerto:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Column="1" x:Name="RigPortTextBox" Style="{StaticResource TextBoxStyle}"
                            Text="3333"/>
                </Grid>
                
                <!-- Tipo de Minería -->
                <TextBlock Text="Tipo de Minería" Style="{StaticResource HeaderStyle}" Margin="0,15,0,0"/>
                
                <StackPanel Orientation="Vertical" Margin="10,5">
                    <CheckBox x:Name="CpuMiningCheckBox" Content="Minería CPU" Style="{StaticResource CheckBoxStyle}" IsChecked="True"/>
                    <CheckBox x:Name="GpuMiningCheckBox" Content="Minería GPU" Style="{StaticResource CheckBoxStyle}" IsChecked="True"/>
                    <CheckBox x:Name="StorageMiningCheckBox" Content="Minería de Almacenamiento" Style="{StaticResource CheckBoxStyle}"/>
                </StackPanel>
                
                <!-- Límites de Recursos -->
                <TextBlock Text="Límites del Rig" Style="{StaticResource HeaderStyle}" Margin="0,15,0,0"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="CPU máximo:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="RigCpuSlider" Style="{StaticResource SliderStyle}"
                           Minimum="10" Maximum="90" TickFrequency="10" IsSnapToTickEnabled="True" Value="50"/>
                    <TextBlock Grid.Column="2" x:Name="RigCpuLabel" Text="50%" 
                              Foreground="#45A29E" FontSize="12" Margin="5,5,10,2" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Información de Conexión -->
                <Border Background="#1A2A3A" CornerRadius="4" Padding="10" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="Información de Conexión" 
                                  Foreground="#66FCF1" FontSize="12" FontWeight="Bold"/>
                        
                        <TextBlock x:Name="ConnectionInfoLabel" 
                                  Text="Estado: No conectado"
                                  Foreground="#C5C6C7" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Botones -->
        <Border Grid.Row="2" Background="#1A2A3A" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" Content="Probar Conexión" Style="{StaticResource ButtonStyle}"
                       Background="#FBB824" Foreground="#000000" Click="TestButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource ButtonStyle}"
                       Click="CancelButton_Click"/>
                <Button x:Name="ConnectButton" Content="Vincular" Style="{StaticResource ButtonStyle}"
                       Background="#00FF8C" Foreground="#000000" Click="ConnectButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>