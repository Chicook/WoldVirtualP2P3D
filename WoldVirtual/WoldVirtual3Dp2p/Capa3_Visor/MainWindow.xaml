<Window x:Class="VisorSingularity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        mc:Ignorable="d"
        Title="Wold Virtual p2p 3D" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="#0A0E17" Foreground="#E2E8F0" FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Custom Futuristic Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#070A10"/>
        <SolidColorBrush x:Key="BgPanel" Color="#0E1524"/>
        <SolidColorBrush x:Key="NeonCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="NeonEmerald" Color="#00FF8C"/>
        <SolidColorBrush x:Key="NeonMagenta" Color="#FF007F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8E9AA8"/>
        
        <!-- Glassmorphic Cyber Button Style -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#121B2D"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#1A80A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E5FF"/>
                    <Setter Property="Foreground" Value="#070A10"/>
                    <Setter Property="BorderBrush" Value="#00FF8C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#00FF8C"/>
                    <Setter Property="Foreground" Value="#070A10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Emerald Neon Button Style -->
        <Style x:Key="EmeraldButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Foreground" Value="#00FF8C"/>
            <Setter Property="BorderBrush" Value="#008C4A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF8C"/>
                    <Setter Property="Foreground" Value="#070A10"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Magenta Neon Button Style -->
        <Style x:Key="MagentaButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Foreground" Value="#FF007F"/>
            <Setter Property="BorderBrush" Value="#8C0046"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF007F"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Futuristic Label Style -->
        <Style x:Key="CyberLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00FF8C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Cyber TextBox Style -->
        <Style x:Key="CyberTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#070A10"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1A80A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cyber PasswordBox Style -->
        <Style x:Key="CyberPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#070A10"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1A80A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/> <!-- Cyber Header -->
            <RowDefinition Height="*"/>  <!-- Main Content (Wizard or 3D) -->
            <RowDefinition Height="45"/> <!-- Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#0E1524" BorderBrush="#00E5FF" BorderThickness="0,0,0,2">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬢" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="WOLD VIRTUAL P2P 3D" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Token & Wallet Info (Dashboard Mode Only) -->
                <TextBlock Grid.Column="1" x:Name="TxtHeaderCryptoInfo" Text="0.000 WCVcoin  wallet: 0xA8E670588bbB447c1e98557C64f740016d908085"
                           Foreground="#00FF8C" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" Visibility="Collapsed"/>

                <!-- Top Menu Mock (Stylized) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="ARCHIVO" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" Margin="10,0" Cursor="Hand"/>
                    <TextBlock Text="EDITAR" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" Margin="10,0" Cursor="Hand"/>
                    <TextBlock Text="AYUDA" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" Margin="10,0" Cursor="Hand"/>
                    <TextBlock Text="ADVANCED" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" Margin="10,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Close & Minimize Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" Background="Transparent" Foreground="#8E9AA8" BorderThickness="0" Width="30" Height="30" Margin="0,0,5,0" Cursor="Hand" Click="BtnMinimize_Click"/>
                    <Button Content="✕" Background="Transparent" Foreground="#FF007F" BorderThickness="0" Width="30" Height="30" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="0"/> <!-- Sidebar, default collapsed (Width=280 inside dashboard) -->
                <ColumnDefinition Width="*"/>   <!-- Viewport / Wizard -->
            </Grid.ColumnDefinitions>

            <!-- ───── SIDEBAR (Identidad & Teletransporte P2P) ───── -->
            <Border Grid.Column="0" x:Name="PanSidebar" Background="#070A10" BorderBrush="#2000E5FF" BorderThickness="0,0,2,0" Visibility="Collapsed">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- User identity card -->
                        <RowDefinition Height="Auto"/> <!-- Node options -->
                        <RowDefinition Height="*"/>    <!-- Teleport lists -->
                    </Grid.RowDefinitions>

                    <!-- Identidad DeFi -->
                    <Border Grid.Row="0" Background="#0E1524" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#1A80A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="IDENTIDAD VINCULADA" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSidebarUsername" Text="CHICOOK" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="METAMASK WALLET" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSidebarWallet" Text="0xa8e6...8085" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="ISLA ACTIVA" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSidebarIsland" Text="137 : 190.1.0" Foreground="#00FF8C" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Opciones del Nodo -->
                    <Border Grid.Row="1" Background="#0E1524" CornerRadius="8" Padding="12" Margin="0,0,0,15" BorderBrush="#1A80A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="OPCIONES DEL NODO" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Button Content="VALIDAR METAMASK" Style="{StaticResource CyberButton}" Margin="0,0,0,8" Click="BtnValidarMetamask_Click"/>
                            <Button Content="CERRAR SESION" Style="{StaticResource MagentaButton}" Click="BtnCerrarSesion_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Teletransporte P2P -->
                    <Border Grid.Row="2" Background="#0E1524" CornerRadius="8" Padding="12" BorderBrush="#1A80A3" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="TELETRANSPORTE P2P" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="0,0,10,10"/>

                            <!-- List of Islands -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="StackIslandsList"/>
                            </ScrollViewer>

                            <TextBlock Grid.Row="2" Text="Selecciona una coordenada espacial P2P registrada para iniciar el hiper-salto cuántico en caliente del motor de renderizado."
                                       Foreground="#8E9AA8" FontSize="9.5" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ───── CENTRAL AREA (Wizard steps & 3D Godot Viewport) ───── -->
            <Grid Grid.Column="1">
                
                <!-- ───── WIZARD STEP 1: PC REGISTRATION (Hardware Binding) ───── -->
                <Grid x:Name="Step1_PC" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0E1524" CornerRadius="12" BorderBrush="#00FF8C" BorderThickness="1.5" Width="550" Padding="35">
                        <StackPanel>
                            <TextBlock Text="⬢  CREADOR DE IDENTIDAD WOLD  ⬢" Foreground="#00FF8C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="PASO 1 DE 4: VINCULACIÓN DE HARDWARE" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            
                            <Border BorderBrush="#2000FF8C" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <TextBlock Text="El Visor enlazará permanentemente tu cuenta con el procesador, placa base y sistema operativo de este computador para máxima seguridad criptográfica."
                                       Foreground="#E2E8F0" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="18"/>

                            <!-- Hardware Telemetry Screen -->
                            <Border Background="#070A10" BorderBrush="#1A80A3" BorderThickness="1" Padding="15" CornerRadius="6" Margin="0,0,0,25">
                                <StackPanel>
                                    <TextBlock x:Name="TxtCpuId" Text="ID PROCESADOR: Cargando..." Foreground="#00E5FF" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtBoardId" Text="PLACA BASE: Cargando..." Foreground="#00E5FF" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtOsId" Text="ID SISTEMA OPERATIVO: Cargando..." Foreground="#00E5FF" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,15"/>
                                    
                                    <Border BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
                                    
                                    <TextBlock Text="FIRMA DIGITAL DE SEGURIDAD (SHA-256):" Foreground="#8E9AA8" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtHwHash" Text="0x..." Foreground="#00FF8C" FontSize="11" FontWeight="Bold" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Optional Password / Login Panel for registered users -->
                            <StackPanel x:Name="PanStep1Login" Visibility="Collapsed" Margin="0,0,0,20">
                                <TextBlock Text="IDENTIDAD DE CUENTA DETECTADA EN ESTE PC" Style="{StaticResource CyberLabel}" Margin="0,0,0,5"/>
                                <Border Background="#121B2D" BorderBrush="#00E5FF" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="USUARIO: " Foreground="#8E9AA8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtStep1LoggedUser" Text="CHICOOK" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="CONTRASEÑA DE SEGURIDAD" Style="{StaticResource CyberLabel}"/>
                                <PasswordBox x:Name="TxtStep1Password" Style="{StaticResource CyberPasswordBox}"/>
                            </StackPanel>

                            <Button x:Name="BtnStep1Action" Content="VINCULAR MAQUINA / SIGUIENTE" Style="{StaticResource EmeraldButton}" Height="45" Click="BtnStep1Next_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ───── WIZARD STEP 2: USER REGISTRATION (Credentials & UUID) ───── -->
                <Grid x:Name="Step2_User" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0E1524" CornerRadius="12" BorderBrush="#00FF8C" BorderThickness="1.5" Width="550" Padding="35">
                        <StackPanel>
                            <TextBlock Text="⬢  CREADOR DE IDENTIDAD WOLD  ⬢" Foreground="#00FF8C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="PASO 2 DE 4: DATOS DE USUARIO Y VALIDACIÓN UUID" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Border BorderBrush="#2000FF8C" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <TextBlock Text="Define los datos de acceso para tu cuenta en este PC y genera tu código de validación de cuenta único."
                                       Foreground="#E2E8F0" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                            <!-- Fields -->
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="NOMBRE DE USUARIO" Style="{StaticResource CyberLabel}"/>
                                <TextBox Grid.Row="1" x:Name="TxtRegUser" Style="{StaticResource CyberTextBox}" Margin="0,0,0,15"/>

                                <TextBlock Grid.Row="2" Text="CONTRASEÑA DE SEGURIDAD" Style="{StaticResource CyberLabel}"/>
                                <PasswordBox Grid.Row="3" x:Name="TxtRegPass" Style="{StaticResource CyberPasswordBox}" Margin="0,0,0,15"/>

                                <TextBlock Grid.Row="4" Text="REPETIR CONTRASEÑA" Style="{StaticResource CyberLabel}"/>
                                <PasswordBox Grid.Row="5" x:Name="TxtRegPassRepeat" Style="{StaticResource CyberPasswordBox}"/>
                            </Grid>

                            <!-- UUID Generator Section -->
                            <Border Background="#070A10" BorderBrush="#1A80A3" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,25">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="UUID DE VALIDACIÓN DE CUENTA:" Foreground="#8E9AA8" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtUuid" Text="Haz clic para generar el UUID" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="GENERAR UUID" Style="{StaticResource CyberButton}" Height="34" Margin="10,0,0,0" Padding="10,5" Click="BtnGenerateUuid_Click"/>
                                </Grid>
                            </Border>

                            <Button Content="CREAR IDENTIDAD / SIGUIENTE" Style="{StaticResource EmeraldButton}" Height="45" Click="BtnStep2Next_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ───── WIZARD STEP 3: METAMASK DEFI VALIDATION (HTTP Bridge) ───── -->
                <Grid x:Name="Step3_Metamask" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0E1524" CornerRadius="12" BorderBrush="#00FF8C" BorderThickness="1.5" Width="550" Padding="35">
                        <StackPanel>
                            <TextBlock Text="⬢  CREADOR DE IDENTIDAD WOLD  ⬢" Foreground="#00FF8C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="PASO 3 DE 4: CONEXION DE METAMASK DEFI WALLET" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Border BorderBrush="#2000FF8C" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <TextBlock Text="Indica la dirección de tu MetaMask DeFi Wallet. Esta dirección vincula criptográficamente tus activos y NFTs de tierras 3D."
                                       Foreground="#E2E8F0" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                            <!-- Fields -->
                            <TextBlock Text="DIRECCION DE METAMASK WALLET" Style="{StaticResource CyberLabel}"/>
                            <TextBox x:Name="TxtWalletAddress" Style="{StaticResource CyberTextBox}" PlaceholderText="0x..." Margin="0,0,0,15"/>

                            <!-- Actions -->
                            <Button Content="GENERAR WALLET DE PRUEBA" Style="{StaticResource CyberButton}" Margin="0,0,0,12" Height="36" Click="BtnGenerateTestWallet_Click"/>
                            
                            <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

                            <TextBlock Text="O valida tu MetaMask real de forma segura abriendo el portal en tu navegador predeterminado:"
                                       Foreground="#8E9AA8" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Button Content="VALIDAR EN NAVEGADOR EXTERNO (METAMASK REAL)" Style="{StaticResource CyberButton}" Foreground="#00FF8C" BorderBrush="#00FF8C" Margin="0,0,0,25" Height="40" Click="BtnValidateRealMetamask_Click"/>

                            <Button Content="CONFIRMAR / SIGUIENTE" Style="{StaticResource EmeraldButton}" Height="45" Click="BtnStep3Next_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ───── WIZARD STEP 4: SELECCIÓN DE ISLA & FINALIZACIÓN ───── -->
                <Grid x:Name="Step4_Island" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#0E1524" CornerRadius="12" BorderBrush="#00FF8C" BorderThickness="1.5" Width="550" Padding="35">
                        <StackPanel>
                            <TextBlock Text="⬢  CREADOR DE IDENTIDAD WOLD  ⬢" Foreground="#00FF8C" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="PASO 4 DE 4: COORDENADAS DE ISLA POR DEFECTO" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <Border BorderBrush="#2000FF8C" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

                            <TextBlock Text="Introduce las coordenadas espaciales de la Isla en la que deseas aparecer por defecto en la red P2P del metaverso."
                                       Foreground="#E2E8F0" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="18"/>

                            <!-- Fields -->
                            <TextBlock Text="COORDENADAS ESPACIALES" Style="{StaticResource CyberLabel}"/>
                            <TextBox x:Name="TxtIslandCoordinates" Style="{StaticResource CyberTextBox}" Text="137 : 190.1.0" Margin="0,0,0,25"/>

                            <Button Content="FINALIZAR REGISTRO Y LANZAR METAVERSO" Style="{StaticResource EmeraldButton}" Height="45" Click="BtnFinalizeRegister_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== VIEWPORT CENTRAL DE DIOS (GODOT 3D CONTAINER) ==================== -->
                <Grid x:Name="PanViewportContainer" Visibility="Collapsed" Background="#070A10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Viewport Alert Bar -->
                        <RowDefinition Height="*"/>    <!-- WinFormsHost -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#121B2D" BorderBrush="#00FF8C" BorderThickness="0,0,0,1" Padding="12">
                        <Grid>
                            <TextBlock x:Name="TxtViewportMessage" Text="● METAVERSO ACTIVO — Conexión cifrada P2P establecida con éxito" Foreground="#00FF8C" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Host Container for Godot Window Rendering -->
                    <wfi:WindowsFormsHost Grid.Row="1" x:Name="WfHost" Background="Black" Focusable="True">
                        <!-- Panel WinForms Embebido de Destino -->
                        <wf:Panel x:Name="WfGamePanel" BackColor="Black"/>
                    </wfi:WindowsFormsHost>
                </Grid>

                <!-- ───── PANTALLA DE ESPERA HTTP METAMASK ───── -->
                <Grid x:Name="PanWaitHttp" Visibility="Collapsed" Background="#C0070A10">
                    <Border Background="#0E1524" CornerRadius="12" BorderBrush="#00E5FF" BorderThickness="1.5" Width="550" Padding="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="⬢  PUENTE HTTP ACTIVO  ⬢" Foreground="#00E5FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="ESPERANDO FIRMA DE METAMASK" Foreground="#8E9AA8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#00E5FF" Background="#121B2D" BorderThickness="0" Margin="0,0,0,25"/>

                            <TextBlock Text="Por favor, completa la confirmación de firma en la pestaña abierta en tu navegador de Internet."
                                       Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" LineHeight="20"/>

                            <TextBlock Text="Si no se abrió automáticamente, accede a: http://localhost:8080 en tu navegador."
                                       Foreground="#00FF8C" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" Margin="0,0,0,25"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ABRIR OTRA VEZ" Style="{StaticResource CyberButton}" Margin="0,0,10,0" Height="36" Click="BtnOpenBrowserAgain_Click"/>
                                <Button Grid.Column="1" Content="USAR MOCK / SIMULAR" Style="{StaticResource EmeraldButton}" Margin="10,0,0,0" Height="36" Click="BtnSimulateWaitConfirm_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="#0E1524" BorderBrush="#1A80A3" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status Message -->
                <TextBlock Grid.Column="0" x:Name="TxtFooterStatus" Text="Listo para iniciar el proceso de enlace seguro en la red Wold." 
                           Foreground="#8E9AA8" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>

                <!-- Right: HTTP Bridge status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFooterHwSignature" Text="ENLACE SEGURO FINGERPRINT: ..." Foreground="#00FF8C" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,25,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFooterBridgeStatus" Text="● PUENTE HTTP: ONLINE" Foreground="#00E5FF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
