<Window x:Class="VisorSingularity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        mc:Ignorable="d"
        Title="Wold Virtual p2p 3D" Height="950" Width="1600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Foreground="#F8FAFC" FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#030712" Offset="0.0"/>
            <GradientStop Color="#0B132A" Offset="0.5"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Gradients and Brushes -->
        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A0D182E" Offset="0.0"/>
            <GradientStop Color="#33060B14" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentCyanGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0.0"/>
            <GradientStop Color="#007ACC" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Drop Shadows -->
        <DropShadowEffect x:Key="GlowCyan" Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="GlowEmerald" Color="#00FF8C" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="GlowMagenta" Color="#FF007F" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="20" ShadowDepth="8" Opacity="0.5"/>

        <!-- Premium Glass Panel -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#900B132A"/>
            <Setter Property="BorderBrush" Value="#30ffffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource PanelShadow}"/>
        </Style>

        <!-- Dynamic Cyber Button -->
        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#4000E5FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3300E5FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowCyan}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#030712"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emerald Dynamic Button -->
        <Style x:Key="EmeraldButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Foreground" Value="#00FF8C"/>
            <Setter Property="BorderBrush" Value="#4000FF8C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3300FF8C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF8C"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowEmerald}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00FF8C"/>
                                <Setter Property="Foreground" Value="#030712"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Magenta Dynamic Button -->
        <Style x:Key="MagentaButton" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Foreground" Value="#FF007F"/>
            <Setter Property="BorderBrush" Value="#40FF007F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FF007F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF007F"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowMagenta}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="#030712"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Futuristic Label Style -->
        <Style x:Key="CyberLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Modern Input Base -->
        <Style x:Key="InputBaseStyle" TargetType="Control">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="CyberTextBox" TargetType="TextBox" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="border" Property="Background" Value="#1A00E5FF"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6000E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource InputBaseStyle}">
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="border" Property="Background" Value="#1A00E5FF"/>
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowCyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6000E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scanline Animation for Progress -->
        <Storyboard x:Key="ProgressAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.8" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/> <!-- Premium Header -->
            <RowDefinition Height="*"/>  <!-- Main Content -->
            <RowDefinition Height="45"/> <!-- Sleek Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#90030712" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A00E5FF" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,15,0">
                        <TextBlock Text="⬢" Foreground="#00E5FF" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WOLD VIRTUAL" Foreground="#F8FAFC" FontSize="18" FontWeight="Black" CharacterSpacing="20"/>
                        <TextBlock Text="P2P 3D VISOR" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" CharacterSpacing="50"/>
                    </StackPanel>
                </StackPanel>

                <!-- Token & Wallet Info -->
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0"
                        Background="#1000FF8C" BorderBrush="#3000FF8C" BorderThickness="1" CornerRadius="20" Padding="15,6">
                    <TextBlock x:Name="TxtHeaderCryptoInfo" Text="0.000 WCVcoin  •  0xA8E6...8085"
                               Foreground="#00FF8C" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed"/>
                </Border>

                <!-- Top Navigation (Stylized) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                    <TextBlock Text="ARCHIVO" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="15,0" Cursor="Hand"/>
                    <TextBlock Text="EDITAR" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="15,0" Cursor="Hand"/>
                    <TextBlock Text="AYUDA" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="15,0" Cursor="Hand"/>
                    <TextBlock Text="ADVANCED" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="15,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" Background="#1AFFFFFF" Foreground="#F8FAFC" BorderThickness="0" Width="36" Height="36" Margin="0,0,10,0" Cursor="Hand" Click="BtnMinimize_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Background="#1AFF007F" Foreground="#FF007F" BorderThickness="0" Width="36" Height="36" FontWeight="Bold" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FF007F"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource GlowMagenta}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="0"/> <!-- Sidebar width manipulated in code -->
                <ColumnDefinition Width="*"/>   <!-- Viewport / Wizard -->
            </Grid.ColumnDefinitions>

            <!-- ───── SIDEBAR (Identidad & Teletransporte P2P) ───── -->
            <Border Grid.Column="0" x:Name="PanSidebar" Background="#90030712" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Identidad DeFi -->
                    <Border Grid.Row="0" Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="IDENTIDAD VINCULADA" Style="{StaticResource CyberLabel}"/>
                            <TextBlock x:Name="TxtSidebarUsername" Text="CHICOOK" Foreground="#00E5FF" FontSize="20" FontWeight="Black" Margin="0,0,0,15">
                                <TextBlock.Effect><DropShadowEffect Color="#00E5FF" BlurRadius="5" ShadowDepth="0"/></TextBlock.Effect>
                            </TextBlock>
                            
                            <TextBlock Text="METAMASK WALLET" Style="{StaticResource CyberLabel}"/>
                            <TextBlock x:Name="TxtSidebarWallet" Text="0xa8e6...8085" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="ISLA ACTIVA" Style="{StaticResource CyberLabel}"/>
                            <TextBlock x:Name="TxtSidebarIsland" Text="137 : 190.1.0" Foreground="#00FF8C" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Opciones del Nodo -->
                    <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="OPCIONES DEL NODO" Style="{StaticResource CyberLabel}" Margin="0,0,0,15"/>
                            <Button Content="VALIDAR METAMASK" Style="{StaticResource CyberButton}" Margin="0,0,0,10" Click="BtnValidarMetamask_Click"/>
                            <Button Content="CERRAR SESION" Style="{StaticResource MagentaButton}" Click="BtnCerrarSesion_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Teletransporte P2P -->
                    <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="TELETRANSPORTE P2P" Style="{StaticResource CyberLabel}" Margin="0,0,0,15"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                                <StackPanel x:Name="StackIslandsList"/>
                            </ScrollViewer>

                            <TextBlock Grid.Row="2" Text="Selecciona una coordenada espacial P2P registrada para iniciar el hiper-salto cuántico en caliente del motor de renderizado."
                                       Foreground="#64748B" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ───── CENTRAL AREA (Wizard steps OR 3D Godot Viewport) ───── -->
            <Grid Grid.Column="1">
                
                <!-- WIZARD STEPS CONTAINER -->
                <Grid x:Name="WizardContainer" Visibility="Visible">
                    <!-- Background aesthetic for wizard -->
                    <Border>
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                <GradientStop Color="#1A00E5FF" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    
                    <Grid>
                        <!-- ───── WIZARD STEP 1: PC REGISTRATION ───── -->
                        <Grid x:Name="Step1_PC" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource GlassPanel}" Width="700" Padding="45">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="⬢" Foreground="#00FF8C" FontSize="24" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="CREADOR DE IDENTIDAD WOLD" Foreground="#F8FAFC" FontSize="22" FontWeight="Black"/>
                                    </StackPanel>
                                    <TextBlock Text="PASO 1 DE 4: VINCULACIÓN DE HARDWARE" Foreground="#00FF8C" FontSize="12" FontWeight="Bold" CharacterSpacing="20" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                                    
                                    <TextBlock Text="El Visor enlazará permanentemente tu cuenta con el procesador, placa base y sistema operativo de este computador para máxima seguridad criptográfica."
                                               Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,30" LineHeight="22" TextAlignment="Center"/>

                                    <Border Background="#0Affffff" BorderBrush="#20ffffff" BorderThickness="1" Padding="20" CornerRadius="12" Margin="0,0,0,30">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtCpuId" Text="ID PROCESADOR: Cargando..." Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="TxtBoardId" Text="PLACA BASE: Cargando..." Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="TxtOsId" Text="ID SISTEMA OPERATIVO: Cargando..." Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,0,20"/>
                                            
                                            <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>
                                            
                                            <TextBlock Text="FIRMA DIGITAL DE SEGURIDAD (SHA-256):" Style="{StaticResource CyberLabel}"/>
                                            <TextBlock x:Name="TxtHwHash" Text="0x..." Foreground="#00FF8C" FontSize="12" FontWeight="Bold" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Optional Login Panel -->
                                    <StackPanel x:Name="PanStep1Login" Visibility="Collapsed" Margin="0,0,0,25">
                                        <TextBlock Text="IDENTIDAD DE CUENTA DETECTADA" Style="{StaticResource CyberLabel}"/>
                                        <Border Background="#1A00E5FF" BorderBrush="#00E5FF" BorderThickness="1" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="USUARIO:" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtStep1LoggedUser" Text="CHICOOK" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="CONTRASEÑA DE SEGURIDAD" Style="{StaticResource CyberLabel}"/>
                                        <PasswordBox x:Name="TxtStep1Password" Style="{StaticResource CyberPasswordBox}" Height="40"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnDownloadZip" Content="⬇ GUARDAR FIRMA" Style="{StaticResource CyberButton}" Height="50" Click="BtnDownloadZip_Click"/>
                                        <Button Grid.Column="2" x:Name="BtnStep1Action" Content="VINCULAR / SIGUIENTE ➔" Style="{StaticResource EmeraldButton}" Height="50" IsEnabled="False" Click="BtnStep1Next_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ───── WIZARD STEP 2: USER REGISTRATION ───── -->
                        <Grid x:Name="Step2_User" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource GlassPanel}" Width="700" Padding="45">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="⬢" Foreground="#00FF8C" FontSize="24" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="CREADOR DE IDENTIDAD WOLD" Foreground="#F8FAFC" FontSize="22" FontWeight="Black"/>
                                    </StackPanel>
                                    <TextBlock Text="PASO 2 DE 4: DATOS DE USUARIO" Foreground="#00FF8C" FontSize="12" FontWeight="Bold" CharacterSpacing="20" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                                    <Grid Margin="0,0,0,25">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="NOMBRE DE USUARIO" Style="{StaticResource CyberLabel}"/>
                                        <TextBox Grid.Row="1" x:Name="TxtRegUser" Style="{StaticResource CyberTextBox}" Height="42" Margin="0,0,0,20"/>

                                        <TextBlock Grid.Row="2" Text="CONTRASEÑA DE SEGURIDAD" Style="{StaticResource CyberLabel}"/>
                                        <PasswordBox Grid.Row="3" x:Name="TxtRegPass" Style="{StaticResource CyberPasswordBox}" Height="42" Margin="0,0,0,20"/>

                                        <TextBlock Grid.Row="4" Text="REPETIR CONTRASEÑA" Style="{StaticResource CyberLabel}"/>
                                        <PasswordBox Grid.Row="5" x:Name="TxtRegPassRepeat" Style="{StaticResource CyberPasswordBox}" Height="42"/>
                                    </Grid>

                                    <!-- UUID Generator Section -->
                                    <Border Background="#0Affffff" BorderBrush="#20ffffff" BorderThickness="1" Padding="15" CornerRadius="8" Margin="0,0,0,30">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="UUID DE VALIDACIÓN DE CUENTA:" Style="{StaticResource CyberLabel}" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="TxtUuid" Text="Haz clic para generar el UUID" Foreground="#00E5FF" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="GENERAR UUID" Style="{StaticResource CyberButton}" Height="40" Margin="15,0,0,0" Padding="15,0" Click="BtnGenerateUuid_Click"/>
                                        </Grid>
                                    </Border>

                                    <Button Content="CREAR IDENTIDAD / SIGUIENTE ➔" Style="{StaticResource EmeraldButton}" Height="50" Click="BtnStep2Next_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ───── WIZARD STEP 3: METAMASK DEFI VALIDATION ───── -->
                        <Grid x:Name="Step3_Metamask" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource GlassPanel}" Width="700" Padding="45">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="⬢" Foreground="#00FF8C" FontSize="24" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="CREADOR DE IDENTIDAD WOLD" Foreground="#F8FAFC" FontSize="22" FontWeight="Black"/>
                                    </StackPanel>
                                    <TextBlock Text="PASO 3 DE 4: CONEXIÓN METAMASK" Foreground="#00FF8C" FontSize="12" FontWeight="Bold" CharacterSpacing="20" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                                    <TextBlock Text="Vincula tu MetaMask DeFi Wallet de forma criptográfica para sincronizar y validar la propiedad de tus activos y NFTs de islas en 3D."
                                               Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,40" LineHeight="22"/>

                                    <Button Content="🦊 VINCULAR CON METAMASK REAL" Style="{StaticResource EmeraldButton}" Margin="0,0,0,10" Height="60" FontSize="15" Click="BtnValidateRealMetamask_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ───── WIZARD STEP 4: SELECCIÓN DE ISLA & FINALIZACIÓN ───── -->
                        <Grid x:Name="Step4_Island" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource GlassPanel}" Width="700" Padding="45">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="⬢" Foreground="#00FF8C" FontSize="24" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="CREADOR DE IDENTIDAD WOLD" Foreground="#F8FAFC" FontSize="22" FontWeight="Black"/>
                                    </StackPanel>
                                    <TextBlock Text="PASO 4 DE 4: COORDENADAS P2P" Foreground="#00FF8C" FontSize="12" FontWeight="Bold" CharacterSpacing="20" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                                    <TextBlock Text="Se han generado coordenadas espaciales únicas para tu nodo 3D. Tu isla cuántica quedará fija y asegurada de por vida en la red P2P."
                                               Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,30" LineHeight="22"/>

                                    <TextBlock Text="COORDENADAS DE TU ISLA ÚNICA" Style="{StaticResource CyberLabel}"/>
                                    <TextBox x:Name="TxtIslandCoordinates" Style="{StaticResource CyberTextBox}" IsReadOnly="True" Background="#0A000000" Foreground="#00FF8C" FontSize="16" FontWeight="Bold" TextAlignment="Center" Height="50" Margin="0,0,0,35"/>

                                    <Button Content="FINALIZAR REGISTRO Y LANZAR METAVERSO 🚀" Style="{StaticResource EmeraldButton}" Height="60" FontSize="15" Click="BtnFinalizeRegister_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ───── PANTALLA DE ESPERA HTTP METAMASK ───── -->
                        <Grid x:Name="PanWaitHttp" Visibility="Collapsed" Background="#D9030712">
                            <Border Style="{StaticResource GlassPanel}" Width="700" Padding="45" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="⬢ PUENTE HTTP ACTIVO ⬢" Foreground="#00E5FF" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock.Effect><DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0"/></TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="ESPERANDO FIRMA DE METAMASK" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" CharacterSpacing="20" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                                    
                                    <Border Background="#1000E5FF" Height="6" CornerRadius="3" Margin="0,0,0,30" Overflow="Hidden">
                                        <Border Width="150" Background="#00E5FF" CornerRadius="3" HorizontalAlignment="Left">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="-150,0,0,0" To="700,0,0,0" Duration="0:0:1.5"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Border>

                                    <TextBlock Text="Por favor, completa la confirmación de firma en la pestaña abierta en tu navegador de Internet."
                                               Foreground="#F8FAFC" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20" LineHeight="22"/>

                                    <TextBlock Text="Si no se abrió automáticamente, accede a: http://localhost:8080 en tu navegador."
                                               Foreground="#00FF8C" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" TextAlignment="Center" Margin="0,0,0,35"/>

                                    <Button Content="ABRIR PORTAL DE VERIFICACIÓN EN NAVEGADOR" Style="{StaticResource CyberButton}" Height="50" Click="BtnOpenBrowserAgain_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ==================== GODOT VIEWPORT CONTAINER ==================== -->
                <Grid x:Name="PanViewportContainer" Visibility="Collapsed" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#90030712" BorderBrush="#2000E5FF" BorderThickness="0,0,0,1" Padding="15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#00FF8C" Margin="0,0,10,0">
                                <Ellipse.Effect><DropShadowEffect Color="#00FF8C" BlurRadius="5" ShadowDepth="0"/></Ellipse.Effect>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource ProgressAnimation}"/>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="TxtViewportMessage" Text="CENTRO DE CONTROL DEL METAVERSO — Enlace P2P de alta fidelidad activo" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Background="Transparent">
                        <Border x:Name="GodotPlaceholder" Background="Transparent" />
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="#90030712" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TxtFooterStatus" Text="Listo para iniciar el proceso de enlace seguro en la red Wold." 
                           Foreground="#94A3B8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFooterHwSignature" Text="ENLACE SEGURO FINGERPRINT: ..." Foreground="#00FF8C" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,0,30,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#00E5FF" Margin="0,0,6,0">
                            <Ellipse.Effect><DropShadowEffect Color="#00E5FF" BlurRadius="4" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="TxtFooterBridgeStatus" Text="PUENTE HTTP: ONLINE" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
